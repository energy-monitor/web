RewriteEngine on

# one host for the search engines, energy.wifo.ac.at is the same page, e.g. in
# embedded /single/ urls, the url of the pages is in build/pages.js
RewriteCond %{HTTP_HOST} ^energy\.wifo\.ac\.at$ [NC]
RewriteRule ^ https://energie.wifo.ac.at%{REQUEST_URI} [R=301,L]

# the pages are html files of their own, e.g. /collection/gas is
# collection/gas.html, see build/pages.js, only these urls, others as
# /single/<id> would be single.html with the rest of the url
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^((collection|analysis)/[^/]+|include)$ $1.html [L]

# the embedded charts, the app shows the chart of the url
RewriteRule ^single/ single.html [L]

# all other urls are a 404, e.g. former ones as /gas, its page is the app, which
# redirects to the start page, also for missing data, bundles and assets, e.g.
# a deleted chunk of a former version
ErrorDocument 404 /404.html

# the parquet files of the data (next to the csvs), compressed in the file
AddType application/vnd.apache.parquet .parquet

# the text files compressed, e.g. the large csvs of the data, with brotli for
# the browsers which accept it, gzip for the others, each only if the module
# is enabled on the server (a2enmod brotli deflate)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/csv text/markdown application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/csv text/markdown application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# revalidated by the date of the file, the etags of compressed responses do
# not match the ones of the files and are never revalidated
FileETag None

<IfModule mod_headers.c>
    # all other files are revalidated, e.g. index.html with the names of the
    # current bundles
    Header set Cache-Control "no-cache"
    # the bundles, styles and fonts have the hash of their content in the name
    <FilesMatch "\.[0-9a-f]{20}\.(js|css|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # the data, the definitions and the markdown pages change at most daily, a
    # page loaded again within 5 minutes needs no requests for them, within an
    # hour they are shown at once and revalidated in the background, a visit
    # of the next day revalidates them first
    <If "%{REQUEST_URI} =~ m#^/data/#">
        Header set Cache-Control "public, max-age=300, stale-while-revalidate=3600"
    </If>
    # the geometries of the maps change hardly ever
    <If "%{REQUEST_URI} =~ m#^/geo/#">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    </If>
</IfModule>
