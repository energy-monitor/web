{
    "parent": "../_facet-toggle.json",
    "data": "rail-passengers.parquet",
    "options": {
        "height": 220,
        "margins": { "top": 5, "right": 30, "bottom": 30, "left": 50 },
        "title": "Schienenpersonenverkehr",
        "subtitle": "Fahrgäste in Mio. bzw. Verkehrsleistung in Mrd. Personenkilometern, jährlich, alle Eisenbahnunternehmen (ohne U-Bahn und Straßenbahn), AT",
        "footer": "Quelle: Eurostat, Statistik Austria - Schienenpersonenverkehr"
    },
    "mapping": {
        "x": {
            "column": "year",
            "type": "categorical",
            "scale": { "padding": 0.2 },
            "axis": { "values": ["2004", "2008", "2012", "2016", "2020", "2024"] }
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "domain": [0, null],
            "scale": { "domainRel": [0, 0.1] },
            "axis": { "ticks": 6, "grid": true, "format": ",.0f" },
            "hover": { "format": ",.1f" }
        },
        "facet": {
            "column": "measure",
            "categories": {
                "passengers": { "name": "Fahrgäste (Mio.)", "visible": true },
                "pkm": { "name": "Verkehrsleistung (Mrd. Pkm)", "visible": true }
            }
        }
    },
    "facets": {
        "dim": "facet",
        "scales": ["x"],
        "cols": { "steps": ["@totalWidth", { "0": 1, "550": 2 }] }
    },
    "plot": {
        "type": "bar",
        "by": "facet",
        "props": { "fill": "#4A96D4", "opacity": 0.9 },
        "highlight": { "mode": "row", "opacity": 1 }
    }
}
