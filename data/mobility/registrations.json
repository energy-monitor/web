{
    "parent": ["../_years.json", "../_facets.json", "../_scale-switch.json", "../_facet-toggle.json"],
    "data": "registrations.csv",
    "options": {
        "height": 220,
        "title": "Pkw-Neuzulassungen",
        "subtitle": "nach Kraftstoffart bzw. Energiequelle, monatlich",
        "footer": "Source: Statistik Austria - Kfz-Neuzulassungen"
    },
    "globals": {
        "values": "abs"
    },
    "formElements": [{
        "id": "values",
        "name": "Werte",
        "ref": "values",
        "type": "switch",
        "values": [
            { "id": "valuesAbs", "value": "abs", "name": "Anzahl" },
            {
                "id": "valuesShare", "value": "share", "name": "Anteil",
                "mapping": {
                    "y": {
                        "column": "value.share",
                        "axis": { "format": ".0%" },
                        "hover": { "format": ".1%" }
                    }
                }
            }
        ]
    }, {
        "id": "scale",
        "name": "Y-Skala",
        "ref": "shareScale",
        "type": "switch",
        "values": [
            { "id": "shareAxisOff", "value": ["x"], "name": "Getrennt" },
            { "id": "shareAxisOn", "value": ["x", "y"], "name": "Geteilt" }
        ]
    }],
    "mapping": {
        "x": {
            "hover": {
                "format": "%b"
            }
        },
        "y": {
            "hover": {
                "format": ",.0f"
            }
        },
        "facet": {
            "column": "type",
            "props": {
                "manual": {
                    "bev":    { "name": "Elektro", "visible": true },
                    "phev":   { "name": "Plug-in-Hybrid", "visible": true },
                    "hybrid": { "name": "Hybrid (ohne Plug-in)", "visible": true },
                    "petrol": { "name": "Benzin", "visible": true },
                    "diesel": { "name": "Diesel", "visible": true },
                    "other":  { "name": "Sonstige", "visible": false },
                    "total":  { "name": "Gesamt", "visible": false }
                }
            }
        }
    }
}
