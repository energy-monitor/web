{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": [
        "../_years.json",
        "../_facets.json",
        "../_share-switch.json",
        "../_scale-switch.json",
        "../_facet-toggle.json",
        "../_monthly.json"
    ],
    "data": "registrations.parquet",
    "title": "Pkw-Neuzulassungen im Jahresvergleich",
    "subtitle": "nach Kraftstoffart bzw. Energiequelle, monatlich",
    "source": "Quelle: Statistik Austria - Kfz-Neuzulassungen",
    "height": 220,
    "controls": [{"id": "values", "values": [{"id": "valuesAbs", "name": "Anzahl"}, {"id": "valuesShare"}]}],
    "dims": {
        "y": {
            "hover": {"format": "=match(@values, {share: '.1%'}, ',.0f')"},
            "column": "=match(@values, {share: 'value.share'}, 'value')",
            "domain": [0, null],
            "scale": {"pad": [0, 0.1]},
            "axis": {"format": "=match(@values, {share: '.0%'}, ',.0f')"}
        },
        "facet": {
            "column": "type",
            "categories": {
                "bev": {"name": "Elektro", "visible": true},
                "phev": {"name": "Plug-in-Hybrid", "visible": true},
                "hybrid": {"name": "Hybrid (ohne Plug-in)", "visible": true},
                "petrol": {"name": "Benzin", "visible": true},
                "diesel": {"name": "Diesel", "visible": true},
                "other": {"name": "Sonstige", "visible": false},
                "total": {"name": "Gesamt", "visible": false}
            }
        }
    }
}
