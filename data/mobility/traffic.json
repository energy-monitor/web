{
    "parent": "../_timeline.json",
    "data": "traffic.parquet",
    "title": "Verkehrsaufkommen",
    "subtitle": "Autobahnen und Schnellstraßen, durchschnittlicher täglicher Verkehr, monatlich, Index (2025 = 100)",
    "source": "Quelle: ASFINAG - Dauerzählstellen",
    "height": "=steps(@totalWidth, {0: 220, 550: 250, 600: 280})",
    "margins": {"bottom": 45},
    "dims": {
        "road": {"column": "road", "categories": {"total": {"name": "Österreich"}}},
        "vehicle": {
            "column": "vehicle",
            "legend": {},
            "categories": {
                "all": {"name": "Gesamt", "color": "#444444"},
                "light": {"name": "Leicht (bis 3,5 t)", "color": "#4A96D4"},
                "heavy": {"name": "Schwer (über 3,5 t)", "color": "#C3423F"}
            }
        }
    },
    "marks": {
        "type": "line",
        "by": ["road", "vehicle"],
        "curve": "monotoneX",
        "stroke-width": 2,
        "highlight": {"stroke-width": 3}
    },
    "hover": {"columns": ["vehicle"]}
}
