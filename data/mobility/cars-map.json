{
    "title": "Pkw in Europa",
    "subtitle": "Anteile nach Kraftstoffart bzw. Energiequelle, jährlich",
    "footer": "Source: eurostat - road_eqr_carpda (Neuzulassungen), road_eqs_carpda (Bestand)",
    "series": {
        "name": "Daten",
        "values": {
            "registrations": { "name": "Neuzulassungen", "data": "cars-map-registrations.csv" },
            "stock":         { "name": "Bestand",        "data": "cars-map-stock.csv" }
        }
    },
    "yearSelect": true,
    "types": {
        "name": "Kraftstoff",
        "values": {
            "bev":    { "name": "Elektro" },
            "phev":   { "name": "Plug-in-Hybrid" },
            "hybrid": { "name": "Hybrid (ohne Plug-in)" },
            "petrol": { "name": "Benzin" },
            "diesel": { "name": "Diesel" },
            "other":  { "name": "Sonstige" }
        }
    },
    "domain": [0, null],
    "scale": "sqrt",
    "format": ".1%",
    "legendFormat": ".2~%",
    "count": { "column": "value", "format": ",.0f", "unit": "Pkw" }
}
