{
    "parent": "../_europe-map.json",
    "data": "cars-map.parquet",
    "title": "Pkw in Europa",
    "subtitle": "Anteile nach Kraftstoffart bzw. Energiequelle, {year}",
    "source": "Quelle: eurostat - road_eqr_carpda (Neuzulassungen), road_eqs_carpda (Bestand)",
    "globals": {"series": "registrations", "type": "bev"},
    "controls": [
        {
            "type": "radio",
            "global": "series",
            "name": "Daten",
            "values": [
                {"value": "registrations", "name": "Neuzulassungen"},
                {"value": "stock", "name": "Bestand"}
            ]
        },
        {
            "type": "radio",
            "global": "type",
            "name": "Kraftstoff",
            "values": [
                {"value": "bev", "name": "Elektro"},
                {"value": "phev", "name": "Plug-in-Hybrid"},
                {"value": "hybrid", "name": "Hybrid (ohne Plug-in)"},
                {"value": "petrol", "name": "Benzin"},
                {"value": "diesel", "name": "Diesel"},
                {"value": "other", "name": "Sonstige"}
            ]
        },
        {"type": "slider", "global": "year", "name": "Jahr", "values": {"column": "year"}}
    ],
    "filter": {"series": "@globals.series", "type": "@globals.type", "year": "@globals.year"},
    "dims": {
        "label": {"column": "share", "type": "numeric", "format": ".1~%"},
        "series": {"column": "series", "type": "categorical"},
        "type": {"column": "type", "type": "categorical"},
        "year": {"column": "year", "type": "categorical"},
        "value": {
            "name": "Anteil",
            "column": "share",
            "nice": true,
            "scale": {"type": "sequentialSqrt", "interpolator": "Reds"},
            "legend": {"format": ".1~%", "symbol": null},
            "hover": {"format": ".1%"},
            "zero": true
        }
    },
    "hover": {"columns": []}
}
