{
    "parent": ["../_years.json", "../_line-types.json"],
    "data": "fuel-prices.csv",
    "options": {
        "title": "Spritpreise",
        "subtitle": "in €/Liter",
        "footer": "Source: EC Weekly Oil Bulletin"
    },
    "mapping": {
        "y": {
            "column": "last",
            "axis": {
                "format": ",.1f"
            },
            "hover": {
                "format": ",.2f"
            }
        },
        "type": {
            "column": "variable",
            "props": {
                "manual": {
                    "euroSuper95": {
                        "name": "Benzin",
                        "stroke-dasharray": 0
                    },
                    "gasOil": {
                        "name": "Diesel",
                        "stroke-dasharray": "4, 2"
                    },
                    "heatingOil": {
                        "name": "Heizöl",
                        "stroke-dasharray": "5, 5",
                        "visible": false
                    }
                }
            }
        }
    }
}

