{
    "parent": "../_europe-map.json",
    "data": "fuel-prices-map.parquet",
    "title": "Spritpreise in Europa",
    "subtitle": "Preise vom 26.10.2026, inkl. Steuern, in €/Liter",
    "source": "Quelle: EC Weekly Oil Bulletin",
    "locale": {"base": "de", "number": {"currency": ["", " €/l"]}},
    "hover": {"row": "Preisstand: {date}"},
    "globals": {"type": "euroSuper95"},
    "controls": [
        {
            "type": "radio",
            "global": "type",
            "name": "Kraftstoff",
            "values": [
                {"value": "euroSuper95", "name": "Benzin"},
                {"value": "gasOil", "name": "Diesel"},
                {"value": "heatingOil", "name": "Heizöl"}
            ]
        }
    ],
    "filter": {"type": "@globals.type"},
    "dims": {
        "date": {"name": "Preisstand", "column": "date", "hover": {"format": "%d.%m.%Y"}},
        "label": {"column": "value", "format": ",.2f"},
        "type": "variable",
        "value": {
            "name": "€/Liter",
            "column": "value",
            "scale": {"type": "sequential", "interpolator": "Reds"},
            "legend": {"format": ",.1f"},
            "hover": {"format": "$,.2f"}
        }
    }
}
