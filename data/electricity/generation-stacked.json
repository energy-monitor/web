{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "parent": ["../_stacked.json", "../_share-switch.json", "_sources.json"],
    "data": "generation-stacked.parquet",
    "options": {
        "title": "Stromproduktion",
        "subtitle": "nach Quellen, in TWh bzw. Anteile",
        "footer": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C"
    },
    "mapping": {
        "y": {
            "scale": { "domainRel": [0, 0.13] },
            "axis": { "ticks": 7, "format": ".2f" },
            "hover": { "format": ".2f" }
        },
        "type": {
            "categories": {
                "Hydro run-of-river": { "legend": false },
                "Hydro reservoir": { "legend": false },
                "Hydro pumped storage": { "legend": false },
                "others": { "color": "#CCC", "name": "Andere" }
            }
        }
    }
}
