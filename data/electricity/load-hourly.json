{
    "parent": "../_years.json",
    "data": "load-hourly.parquet",
    "title": "Stromverbrauch im Tagesverlauf",
    "subtitle": "laufendes Jahr nicht um saisonale Effekte bereinigt, in GW",
    "source": "Quelle: ENTSO-E - Actual Total Load 6.1.A",
    "dims": {
        "x": {
            "column": "hour",
            "type": "numeric",
            "tickSpacing": 59,
            "scale": {"domainAbs": [-0.2, 0.2]},
            "axis": {"rotate": 0, "format": "c"},
            "hover": {"format": "c"}
        },
        "y": {"axis": {"format": ",.1f"}, "hover": {"format": ",.2f"}}
    },
    "marks": [{"type": "line", "by": "year", "stroke-width": "@stroke-width", "opacity": "@opacity"}]
}
