{
    "parent": "../_years.json",
    "data": "load-hourly.parquet",
    "options": {
        "title": "Stromkonsum im Tagesverlauf",
        "subtitle": "laufendes Jahr nicht um saisonale Effekte bereinigt, in GW",
        "footer": "Quelle: ENTSO-E - Actual Total Load 6.1.A"
    },
    "mapping": {
        "x": {
            "column": "hour",
            "type": "numeric",
            "scale": { "domainAbs": [-0.2, 0.2] },
            "axis": { "ticks": { "*": ["@innerWidth", 0.017] }, "rotate": 0, "format": "c" },
            "hover": { "format": "c" }
        },
        "y": { "axis": { "format": ",.1f" }, "hover": { "format": ",.2f" } }
    },
    "plot": [
        {
            "type": "line",
            "by": "year",
            "props": { "stroke-width": "@stroke-width", "opacity": "@opacity", "stroke": "@color" }
        }
    ]
}
