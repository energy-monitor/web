{
    "parent": ["../_years.json", "../_line-types.json"],
    "data": "price.csv",
    "options": {
        "title": "Strompreis",
        "subtitle": "Day Ahead, täglich (rollierender 7-Tages Durchschnitt), in €/MWh",
        "footer": "Source: ENTSO-E - Day Ahead Prices 12.1.D"
    },
    "mapping": {
        "y": {
            "scale": {
                "domain": [null, null],
                "domainRel": [-0.1, 0.1]
            }
        },
        "year": {
            "props": {
                "manual": {
                    "2019": { "visible": false},
                    "2020": { "visible": false}
                }
            }
        },
        "type": {
            "props": {
                "manual": {
                    "mean": {
                        "name": "⌀",
                        "stroke-dasharray": 0
                    },
                    "min": {
                        "name": "min",
                        "stroke-dasharray": "1, 3"
                    },
                    "max": {
                        "name": "max",
                        "stroke-dasharray": "2, 2"
                    }
                }
            }
        }
    }
}
