{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "parent": ["../_years.json", "../_line-types.json"],
    "data": "price.parquet",
    "options": {
        "title": "Strompreis",
        "subtitle": "Day Ahead, täglich (rollierender 7-Tages Durchschnitt), in €/MWh",
        "footer": "Quelle: ENTSO-E - Day Ahead Prices 12.1.D"
    },
    "mapping": {
        "y": { "domain": [null, null], "scale": { "domainRel": [-0.1, 0.1] } },
        "year": { "categories": { "2019": { "visible": false }, "2020": { "visible": false } } },
        "type": {
            "categories": {
                "mean": { "name": "⌀", "stroke-dasharray": 0 },
                "min": { "name": "min", "stroke-dasharray": "1, 3" },
                "max": { "name": "max", "stroke-dasharray": "2, 2" }
            }
        }
    }
}
