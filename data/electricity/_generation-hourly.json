{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": ["_sources.json", "../_share-switch.json"],
    "data": "generation-hourly-seasons.parquet",
    "subtitle": "=match(@values, {share: '{period} nach Jahreszeit, die Anteile der Quellen an der Produktion, der Verbrauch im Verhältnis zur Produktion'}, '{period} nach Jahreszeit, die Produktion nach Quellen, mittlere Leistung in GW')",
    "locale": {"base": "de", "number": {"currency": ["", " Uhr"]}},
    "highlight": {"transition": 120},
    "globals": {"period": "2025"},
    "controls": [{"type": "radio", "global": "period", "name": "Jahr", "values": {"column": "period"}}],
    "filter": {"period": "@globals.period"},
    "dims": {
        "period": "period",
        "x": {"column": "hour", "format": "$d"},
        "y": {
            "column": "value",
            "domain": "=match(@values, {share: literal([0, null])}, literal([0, null]))",
            "nice": true,
            "grid": true,
            "axis": {"format": ".0f"},
            "hover": {"format": ".2f"}
        },
        "type": {
            "legend": {
                "onlyData": true,
                "symbol": {
                    "size": 14,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {
                                "x": 0,
                                "y": 0,
                                "width": 14,
                                "height": "@symbolHeight",
                                "fill": "@color",
                                "rx": 1
                            }
                        },
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 14,
                                "y1": 7,
                                "y2": 7,
                                "stroke": "@symbolStroke",
                                "stroke-width": 2,
                                "stroke-dasharray": "@symbolDash",
                                "stroke-opacity": "@lineOpacity"
                            }
                        }
                    ]
                }
            },
            "common": {"symbolHeight": 14, "lineWidth": 2, "hoverStyle": "normal"},
            "categories": {
                "Oil": {"color": "#000", "name": "Erdöl", "legend": false},
                "others": {"color": "#CCC", "name": "Andere"},
                "total": {
                    "color": "#222",
                    "name": "Produktion",
                    "symbolHeight": 0,
                    "symbolStroke": "#222",
                    "lineWidth": 1.5,
                    "hoverStyle": "italic"
                },
                "load": {
                    "color": "#222",
                    "name": "Verbrauch",
                    "symbolHeight": 0,
                    "symbolStroke": "#222",
                    "symbolDash": "4 2",
                    "dash": "5 3",
                    "lineOpacity": 0.5,
                    "hoverStyle": "italic"
                },
                "load.pumping": {
                    "color": "#222",
                    "name": "Verbrauch mit Pumpen",
                    "visible": false,
                    "symbolHeight": 0,
                    "symbolStroke": "#222",
                    "symbolDash": "1.5 2",
                    "dash": "1.5 2.5",
                    "lineWidth": 1.5,
                    "lineOpacity": 0.8,
                    "hoverStyle": "italic"
                }
            },
            "hover": {"row": {"props": {"font-style": "@hoverStyle"}}}
        },
        "facet": {
            "column": "season",
            "categories": {
                "winter": {"name": "Winter (Dez–Feb)"},
                "spring": {"name": "Frühling (Mär–Mai)"},
                "summer": {"name": "Sommer (Jun–Aug)"},
                "autumn": {"name": "Herbst (Sep–Nov)"}
            }
        }
    },
    "marks": [
        {
            "type": "area",
            "id": "areas",
            "by": ["type", "facet"],
            "filter": "@type != 'total' and @type != 'load' and @type != 'load.pumping'",
            "stack": "@type != 'total' and @type != 'load' and @type != 'load.pumping'",
            "fill-opacity": 0.9,
            "stroke": "#FFFFFF",
            "stroke-width": 0.8,
            "highlight": {"fill-opacity": 1},
            "others": {"fill-opacity": 0.35}
        },
        {
            "type": "text",
            "id": "names",
            "by": ["facet", "type"],
            "place": {"in": "areas", "padding": 0},
            "halo": true,
            "filter": "@type != 'total' and @type != 'load' and @type != 'load.pumping'",
            "font-size": 11,
            "font-weight": "bold",
            "text": "@name",
            "pointer-events": "none",
            "fill": null,
            "highlight": {"opacity": 1},
            "others": {"opacity": 0.3}
        },
        {
            "type": "line",
            "id": "lines",
            "by": ["type", "facet"],
            "filter": {"type": ["total", "load", "load.pumping"]},
            "stroke-width": "@lineWidth",
            "stroke-dasharray": "@dash",
            "stroke-opacity": "@lineOpacity",
            "highlight": {"stroke-width": 2.5, "stroke-opacity": 1},
            "others": {"opacity": 0.35}
        }
    ],
    "facets": {"by": "facet", "cols": "=steps(@totalWidth, {0: 1, 700: 2})", "scales": "shared"}
}
