{
    "parent": "_sources.json",
    "data": "generation-hourly.parquet",
    "title": "Stromproduktion im Tagesverlauf",
    "subtitle": "im Jahr 2025, nach Quellen, mittlere Leistung in GW",
    "source": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C; Stunden in Ortszeit",
    "height": 350,
    "margins": {"bottom": 35},
    "dims": {
        "x": {"column": "hour", "format": "c", "tickSpacing": 59},
        "y": {
            "column": "value",
            "format": ".2f",
            "zero": true,
            "pad": [0, 0.13],
            "ticks": 7,
            "grid": true
        },
        "type": {
            "legend": {"onlyData": true, "symbol": "rect"},
            "categories": {
                "Waste": {"color": "#ABD6A9", "name": "Müll"},
                "Oil": {"color": "#000", "name": "Erdöl"},
                "others": {"color": "#CCC", "name": "Andere"}
            }
        }
    },
    "marks": {
        "type": "bar",
        "by": "type",
        "stack": true,
        "opacity": 0.9,
        "width": "@innerWidth * 0.025",
        "highlight": {"mode": "row", "opacity": 1}
    }
}
