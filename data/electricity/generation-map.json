{
    "parent": "../_europe-map.json",
    "data": "generation-map.parquet",
    "title": "Stromproduktion",
    "subtitle": "nach Quellen, Anteile, {year}",
    "source": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C",
    "globals": {"type": "Renewable", "year": "2025"},
    "controls": [
        {
            "type": "radio",
            "global": "type",
            "name": "Quelle",
            "values": [
                {"value": "Renewable", "name": "Erneuerbar"},
                {"value": "Non-Renewable", "name": "Fossil"},
                {"value": "Nuclear", "name": "Kernenergie"},
                {"value": "others", "name": "Andere"}
            ]
        },
        {"type": "slider", "global": "year", "name": "Jahr", "values": {"column": "year"}}
    ],
    "filter": {"type": "@globals.type", "year": "@globals.year"},
    "dims": {
        "label": {"column": "share", "format": ".0%"},
        "type": "type",
        "year": "year",
        "value": {
            "name": "Anteil an der Stromproduktion",
            "column": "share",
            "format": ".0%",
            "domain": [0, 1],
            "scale": {"type": "sequential", "interpolator": "Reds"},
            "hover": {}
        }
    }
}
