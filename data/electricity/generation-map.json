{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "parent": "../_europe-map.json",
    "data": "generation-map.parquet",
    "options": {
        "title": "Stromproduktion",
        "subtitle": "nach Quellen, Anteile, jährlich",
        "footer": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C"
    },
    "globals": { "type": "Renewable", "year": "2025" },
    "filter": { "type": "@type", "year": "@year" },
    "formElements": [
        {
            "id": "type",
            "name": "Quelle",
            "ref": "type",
            "type": "radio",
            "values": [
                { "id": "Renewable", "name": "Erneuerbar", "value": "Renewable" },
                { "id": "Non-Renewable", "name": "Fossil", "value": "Non-Renewable" },
                { "id": "Nuclear", "name": "Nuclear", "value": "Nuclear" },
                { "id": "others", "name": "Andere", "value": "others" }
            ]
        },
        {
            "id": "year",
            "name": "Jahr",
            "ref": "year",
            "type": "slider",
            "values": { "column": "year" }
        }
    ],
    "mapping": {
        "type": { "column": "type", "type": "categorical" },
        "year": { "column": "year", "type": "categorical" },
        "value": {
            "name": "Anteil an der Stromproduktion",
            "column": "share",
            "domain": [0, 1],
            "scale": { "type": "sequential", "interpolator": "Reds" },
            "legend": { "format": ".0%" },
            "hover": { "format": ".0%" }
        }
    }
}
