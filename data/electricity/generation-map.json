{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "../_europe-map.json",
    "data": "generation-map.parquet",
    "title": "Stromproduktion",
    "subtitle": "nach Quellen, Anteile, {year}",
    "source": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C",
    "globals": {"type": "Renewable", "year": "2025"},
    "controls": [
        {
            "type": "radio",
            "global": "type",
            "name": "Quelle",
            "id": "type",
            "values": [
                {"id": "Renewable", "name": "Erneuerbar", "value": "Renewable"},
                {"id": "Non-Renewable", "name": "Fossil", "value": "Non-Renewable"},
                {"id": "Nuclear", "name": "Kernenergie", "value": "Nuclear"},
                {"id": "others", "name": "Andere", "value": "others"}
            ]
        },
        {
            "type": "slider",
            "global": "year",
            "name": "Jahr",
            "id": "year",
            "values": {"column": "year"}
        }
    ],
    "filter": {"type": "@globals.type", "year": "@globals.year"},
    "dims": {
        "label": {"column": "share", "type": "numeric", "format": ".0%"},
        "type": {"column": "type", "type": "categorical"},
        "year": {"column": "year", "type": "categorical"},
        "value": {
            "name": "Anteil an der Stromproduktion",
            "column": "share",
            "domain": [0, 1],
            "scale": {"type": "sequential", "interpolator": "Reds"},
            "legend": {"format": ".0%", "symbol": null},
            "hover": {"format": ".0%"}
        }
    }
}
