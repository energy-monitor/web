{
    "parent": ["_sources.json", "../_share-switch.json"],
    "data": "generation-hourly-seasons.parquet",
    "title": "Stromproduktion und -verbrauch im Tagesverlauf, ein Tag im Kreis",
    "subtitle": "=match(@values, {share: '{period} nach Jahreszeit, die Anteile der Quellen an der Produktion, der Verbrauch im Verhältnis zur Produktion'}, '{period} nach Jahreszeit, die Produktion nach Quellen, mittlere Leistung in GW')",
    "source": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C, Actual Total Load 6.1.A, das Pumpen der Pumpspeicher (16.1.B C, nicht in der Last); Stunden in Ortszeit, Mitternacht oben, der Winter ab dem Dezember des Vorjahres",
    "height": "=steps(@totalWidth, {0: 300, 900: 380})",
    "margins": {"top": 26, "right": 52, "bottom": 26, "left": 52},
    "coord": "polar",
    "locale": {"base": "de", "number": {"currency": ["", " Uhr"]}},
    "class": "polar-chart",
    "highlight": {"transition": 120},
    "globals": {"period": "2025"},
    "controls": [
        {
            "type": "radio",
            "global": "period",
            "name": "Jahr",
            "id": "period",
            "values": {"column": "period"}
        },
        {"id": "values", "values": [{"id": "valuesShare"}]}
    ],
    "filter": {"period": "@globals.period"},
    "dims": {
        "period": {"column": "period", "type": "categorical"},
        "x": {
            "column": "hour",
            "type": "numeric",
            "domain": [0, 24],
            "format": "$d",
            "axis": {
                "values": [0, 6, 12, 18],
                "domain": {"props": {"stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75}},
                "tickMarks": {"props": {"stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75}}
            },
            "grid": true
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "domain": "=match(@values, {share: literal([0, null])}, literal([0, null]))",
            "nice": true,
            "scale": {"range": ["@radius * 0.22", "@radius"]},
            "axis": {
                "angle": 90,
                "ticks": 3,
                "format": ".0f",
                "labels": {
                    "props": {"fill": "#777", "font-size": 10, "stroke-width": 2, "stroke-opacity": 0.5}
                },
                "domain": {"props": {"stroke": "none"}}
            },
            "hover": {"format": ".2f"},
            "grid": true
        },
        "type": {
            "legend": {
                "onlyData": true,
                "symbol": {
                    "size": 14,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {
                                "x": 0,
                                "y": 0,
                                "width": 14,
                                "height": "@symbolHeight",
                                "fill": "@color",
                                "rx": 1
                            }
                        },
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 14,
                                "y1": 7,
                                "y2": 7,
                                "stroke": "@symbolStroke",
                                "stroke-width": 2,
                                "stroke-dasharray": "@symbolDash",
                                "stroke-opacity": "@lineOpacity"
                            }
                        }
                    ]
                }
            },
            "common": {
                "symbolHeight": 14,
                "symbolStroke": "none",
                "symbolDash": "none",
                "dash": "none",
                "lineWidth": 2,
                "lineOpacity": 1,
                "hoverStyle": "normal"
            },
            "categories": {
                "Oil": {"color": "#000", "name": "Erdöl", "legend": false},
                "others": {"color": "#CCC", "name": "Andere"},
                "total": {
                    "color": "#222",
                    "name": "Produktion",
                    "symbolHeight": 0,
                    "symbolStroke": "#222",
                    "lineWidth": 1.5,
                    "hoverStyle": "italic"
                },
                "load": {
                    "color": "#222",
                    "name": "Verbrauch",
                    "symbolHeight": 0,
                    "symbolStroke": "#222",
                    "symbolDash": "4 2",
                    "dash": "5 3",
                    "lineOpacity": 0.5,
                    "hoverStyle": "italic"
                },
                "load.pumping": {
                    "color": "#222",
                    "name": "Verbrauch mit Pumpen",
                    "visible": false,
                    "symbolHeight": 0,
                    "symbolStroke": "#222",
                    "symbolDash": "1.5 2",
                    "dash": "1.5 2.5",
                    "lineWidth": 1.5,
                    "lineOpacity": 0.8,
                    "hoverStyle": "italic"
                }
            },
            "hover": {"row": {"props": {"font-style": "@hoverStyle"}}}
        },
        "facet": {
            "column": "season",
            "categories": {
                "winter": {"name": "Winter (Dez–Feb)"},
                "spring": {"name": "Frühling (Mär–Mai)"},
                "summer": {"name": "Sommer (Jun–Aug)"},
                "autumn": {"name": "Herbst (Sep–Nov)"}
            }
        }
    },
    "marks": [
        {
            "type": "area",
            "id": "areas",
            "by": ["type", "facet"],
            "curve": "catmullRomClosed",
            "filter": "@type != 'total' and @type != 'load' and @type != 'load.pumping'",
            "stack": "@type != 'total' and @type != 'load' and @type != 'load.pumping'",
            "fill-opacity": 0.9,
            "stroke": "#FFFFFF",
            "stroke-width": 0.8,
            "highlight": {"fill-opacity": 1},
            "others": {"fill-opacity": 0.35}
        },
        {
            "type": "text",
            "id": "names",
            "by": ["facet", "type"],
            "place": {"in": "areas", "padding": 0},
            "halo": true,
            "filter": "@type != 'total' and @type != 'load' and @type != 'load.pumping'",
            "font-size": 11,
            "font-weight": "bold",
            "text": "@name",
            "pointer-events": "none",
            "fill": null,
            "highlight": {"opacity": 1},
            "others": {"opacity": 0.3}
        },
        {
            "type": "line",
            "id": "lines",
            "by": ["type", "facet"],
            "curve": "catmullRomClosed",
            "filter": "@type == 'total' or @type == 'load' or @type == 'load.pumping'",
            "stroke-width": "@lineWidth",
            "stroke-dasharray": "@dash",
            "stroke-opacity": "@lineOpacity",
            "highlight": {"stroke-width": 2.5, "stroke-opacity": 1},
            "others": {"opacity": 0.35}
        }
    ],
    "annotations": [{"type": "line", "y": 0, "above": true}],
    "facets": {"by": "facet", "cols": "=steps(@totalWidth, {0: 1, 700: 2})", "scales": ["x", "y"]}
}
