{
    "parent": "_generation-hourly.json",
    "title": "Stromproduktion und -verbrauch im Tagesverlauf, ein Tag im Kreis",
    "source": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C, Actual Total Load 6.1.A, das Pumpen der Pumpspeicher (16.1.B C, nicht in der Last); Stunden in Ortszeit, Mitternacht oben, der Winter ab dem Dezember des Vorjahres",
    "height": "=steps(@totalWidth, {0: 300, 900: 380})",
    "margins": {"top": 26, "right": 52, "bottom": 26, "left": 52},
    "coord": "polar",
    "class": "polar-chart",
    "dims": {
        "x": {
            "domain": [0, 24],
            "grid": true,
            "axis": {
                "values": [0, 6, 12, 18],
                "domain": {"props": {"stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75}},
                "tickMarks": {"props": {"stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75}}
            }
        },
        "y": {
            "ticks": 3,
            "range": ["@radius * 0.22", "@radius"],
            "axis": {
                "angle": 90,
                "labels": {
                    "props": {"fill": "#777", "font-size": 10, "stroke-width": 2, "stroke-opacity": 0.5}
                },
                "domain": {"props": {"stroke": "none"}}
            }
        }
    },
    "marks": [{"id": "areas", "curve": "catmullRomClosed"}, {"id": "lines", "curve": "catmullRomClosed"}],
    "annotations": {"type": "line", "y": 0, "above": true}
}
