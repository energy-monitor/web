{
    "parent": ["_sources.json", "../_share-switch.json"],
    "data": "generation-hourly-seasons.parquet",
    "options": {
        "coord": "polar",
        "class": "polar-chart",
        "height": { "prop": "steps", "ref": "totalWidth", "steps": [{ "cut": 0, "value": 300 }, { "cut": 900, "value": 380 }] },
        "margins": {"top": 26, "right": 52, "bottom": 26, "left": 52},
        "title": "Stromproduktion und -verbrauch im Tagesverlauf, ein Tag im Kreis",
        "subtitle": "{period} nach Jahreszeit, die Produktion nach Quellen, mittlere Leistung in GW",
        "footer": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C, Actual Total Load 6.1.A, das Pumpen der Pumpspeicher (16.1.B C, nicht in der Last); Stunden in Ortszeit, Mitternacht oben, der Winter ab dem Dezember des Vorjahres",
        "locale": { "base": "de", "number": { "currency": ["", " Uhr"] } },
        "highlight": { "transition": 120 }
    },
    "globals": { "period": "2025" },
    "filter": { "period": "@period" },
    "formElements": [
        { "id": "period", "name": "Jahr", "ref": "period", "type": "radio", "values": { "column": "period" } },
        {
            "id": "values",
            "values": [{
                "id": "valuesShare",
                "patch": {
                    "options": { "subtitle": "{period} nach Jahreszeit, die Anteile der Quellen an der Produktion, der Verbrauch im Verhältnis zur Produktion" },
                    "mapping": {
                        "y": { "scale": { "domain": [0, null] } }
                    },
                    "plot": [{ "id": "names", "filter": { "y": { "range": [0.12, null] } } }]
                }
            }]
        }
    ],
    "mapping": {
        "period": { "column": "period", "type": "categorical" },
        "x": {
            "column": "hour",
            "type": "numeric",
            "scale": { "type": "linear", "orientation": "angular", "domain": [0, 24] },
            "axis": {
                "position": "angular", "format": "$d", "values": [0, 6, 12, 18], "grid": true,
                "domain": { "props": { "stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75 } },
                "tickMarks": { "props": { "stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75 } }
            },
            "hover": { "format": "$d" }
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "stacked": { "type": { "not": ["total", "load", "load.pumping"] } },
            "scale": { "orientation": "radial", "domain": [0, null], "nice": true, "range": [{ "prop": "relative", "ref": "radius", "ratio": 0.22 }, "@radius"] },
            "axis": {
                "position": "radial", "angle": 90, "ticks": 3, "grid": true, "format": ".0f",
                "labels": { "props": { "fill": "#777", "font-size": 10, "stroke-width": 2, "stroke-opacity": 0.5 } },
                "domain": { "props": { "stroke": "none" } }
            },
            "hover": { "format": ".2f" }
        },
        "type": {
            "legend": {
                "onlyData": true,
                "symbol": { "size": 14, "elements": [
                    { "type": "rect", "props": { "x": 0, "y": 0, "width": 14, "height": "@symbolHeight", "fill": "@color", "rx": 1 } },
                    { "type": "line", "props": { "x1": 0, "x2": 14, "y1": 7, "y2": 7, "stroke": "@symbolStroke", "stroke-width": 2, "stroke-dasharray": "@symbolDash", "stroke-opacity": "@lineOpacity" } }
                ] }
            },
            "props": {
                "common": { "symbolHeight": 14, "symbolStroke": "none", "symbolDash": "none", "dash": "none", "lineWidth": 2, "lineOpacity": 1, "hoverStyle": "normal" },
                "categories": {
                    "Oil":    { "color": "#000", "name": "Erdöl", "legend": false },
                    "others": { "color": "#CCC", "name": "Andere" },
                    "total":  { "color": "#222", "name": "Produktion", "symbolHeight": 0, "symbolStroke": "#222", "lineWidth": 1.5, "hoverStyle": "italic" },
                    "load":   { "color": "#222", "name": "Verbrauch", "symbolHeight": 0, "symbolStroke": "#222", "symbolDash": "4 2", "dash": "5 3", "lineOpacity": 0.5, "hoverStyle": "italic" },
                    "load.pumping": { "color": "#222", "name": "Verbrauch mit Pumpen", "symbolHeight": 0, "symbolStroke": "#222", "symbolDash": "1.5 2", "dash": "1.5 2.5", "lineWidth": 1.5, "lineOpacity": 0.8, "hoverStyle": "italic" }
                }
            },
            "hover": { "row": { "props": { "font-style": "@hoverStyle" } } }
        },
        "facet": {
            "column": "season",
            "props": {
                "categories": {
                    "winter": { "name": "Winter (Dez–Feb)" },
                    "spring": { "name": "Frühling (Mär–Mai)" },
                    "summer": { "name": "Sommer (Jun–Aug)" },
                    "autumn": { "name": "Herbst (Sep–Nov)" }
                }
            }
        }
    },
    "facets": {
        "dim": "facet",
        "scales": ["x", "y"],
        "cols": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [
                {"cut":    0, "value": 1},
                {"cut":  700, "value": 2}
            ]
        }
    },
    "annotations": [
        { "type": "line", "y": 0, "above": true }
    ],
    "plot": [
        {
            "id": "areas",
            "type": "polar:area",
            "categories": ["type", "facet"],
            "filter": { "type": { "not": ["total", "load", "load.pumping"] } },
            "curve": "catmullRomClosed",
            "props": {
                "d": { "angle": "@x:scaled", "innerRadius": "@y:start:scaled", "outerRadius": "@y:end:scaled" },
                "fill": "@color",
                "fill-opacity": 0.9,
                "stroke": "#FFFFFF",
                "stroke-width": 0.8,
                "highlight-fill-opacity": 1,
                "others-fill-opacity": 0.35
            }
        },
        {
            "id": "names",
            "type": "polar:text",
            "categories": ["facet", "type"],
            "select": { "max": "y" },
            "halo": true,
            "dodge": 12,
            "filter": { "type": { "not": ["total", "load", "load.pumping"] }, "x": [21, 22, 23, 0, 1, 2, 3, 9, 10, 11, 12, 13, 14, 15], "y": { "range": [0.9, null] } },
            "props": {
                "angle": "@x:scaled", "radius": "@y:mid:scaled", "text-anchor": "middle", "dominant-baseline": "central",
                "font-size": 11, "font-weight": "bold", "text": "@name",
                "pointer-events": "none", "highlight-opacity": 1, "others-opacity": 0.3
            }
        },
        {
            "id": "lines",
            "type": "polar:line",
            "categories": ["type", "facet"],
            "filter": { "type": ["total", "load", "load.pumping"] },
            "curve": "catmullRomClosed",
            "props": {
                "d": { "angle": "@x:scaled", "radius": "@y:scaled" },
                "stroke": "@color", "stroke-width": "@lineWidth", "stroke-dasharray": "@dash", "stroke-opacity": "@lineOpacity", "fill": "none",
                "highlight-stroke-width": 2.5, "highlight-stroke-opacity": 1, "others-opacity": 0.35
            }
        }
    ]
}
