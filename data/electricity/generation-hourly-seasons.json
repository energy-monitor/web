{
    "parent": "_generation-hourly.json",
    "title": "Stromproduktion und -verbrauch im Tagesverlauf",
    "source": "Quelle: ENTSO-E - Aggregated Generation Per Type 16.1.B C, Actual Total Load 6.1.A, das Pumpen der Pumpspeicher (16.1.B C, nicht in der Last); Stunden in Ortszeit, der Winter ab dem Dezember des Vorjahres",
    "height": 220,
    "margins": {"top": 18, "right": 25, "bottom": 35, "left": 40},
    "dims": {
        "x": {"domain": [0, 24], "axis": {"values": [0, 6, 12, 18, 24]}},
        "y": {"pad": "=match(@values, {share: literal([0, 0.05])}, literal([0, 0.05]))", "ticks": 5}
    },
    "marks": [
        {"id": "areas", "curve": "monotoneX", "layer": "below"},
        {
            "id": "names",
            "layer": "above",
            "filter": "@type != 'total' and @type != 'load' and @type != 'load.pumping' and 1 <= @x <= 23"
        },
        {"id": "lines", "curve": "monotoneX", "layer": "above"}
    ],
    "annotations": {
        "type": "text",
        "x": 12,
        "text": "Mittag",
        "above": true,
        "props": {
            "dy": 4,
            "text-anchor": "middle",
            "dominant-baseline": "hanging",
            "paint-order": "stroke",
            "stroke": "var(--gen-vis-halo-color, white)",
            "stroke-width": 3
        }
    }
}
