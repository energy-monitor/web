{
    "parent": "../_europe-map.json",
    "data": "price-map.parquet",
    "title": "Strompreise in Europa",
    "subtitle": "=match(@price, {peak: 'Day Ahead, Mittel von Montag bis Freitag 8-20 Uhr des Monats nach Gebotszonen, in €/MWh', offpeak: 'Day Ahead, Mittel der Nächte und Wochenenden des Monats nach Gebotszonen, in €/MWh', negative: 'Day Ahead, Stunden mit negativem Preis im Monat nach Gebotszonen'}, 'Day Ahead, Mittel aller Stunden des Monats nach Gebotszonen, in €/MWh')",
    "source": "Quelle: ENTSO-E - Day Ahead Prices 12.1.D; Gebotszonen: <a href=\"https://github.com/EnergieID/entsoe-py\" target=\"_blank\">entsoe-py</a>, Natural Earth",
    "locale": {"base": "de", "number": {"currency": ["", " €/MWh"]}},
    "hover": {
        "row": "<table class=\"vis-hover-table\"><tr><td>Base</td><td style=\"text-align:right\">{base}</td></tr><tr><td>Peak</td><td style=\"text-align:right\">{peak}</td></tr><tr><td>Off-Peak</td><td style=\"text-align:right\">{offpeak}</td></tr><tr><td>Tiefster</td><td style=\"text-align:right\">{min}</td></tr><tr><td>Höchster</td><td style=\"text-align:right\">{max}</td></tr><tr><td>Negative Preise</td><td style=\"text-align:right\">{negative} h</td></tr></table>",
        "columns": []
    },
    "globals": {"price": "base"},
    "controls": [
        {
            "type": "slider",
            "global": "month",
            "name": "Monat",
            "id": "month",
            "values": {"column": "month", "format": "%b %Y"}
        },
        {
            "type": "radio",
            "global": "price",
            "name": "Preis",
            "id": "price",
            "values": [
                {"id": "base", "name": "Base", "value": "base"},
                {"id": "peak", "name": "Peak", "value": "peak"},
                {"id": "offpeak", "name": "Off-Peak", "value": "offpeak"},
                {"id": "negative", "name": "Negative Preise", "value": "negative"}
            ]
        }
    ],
    "filter": {"month": "@globals.month"},
    "dims": {
        "month": {"column": "month", "type": "categorical"},
        "country": {
            "categories": {
                "DE_LU": {"name": "Deutschland und Luxemburg"},
                "DK1": {"name": "Dänemark West (DK1)"},
                "DK2": {"name": "Dänemark Ost (DK2)"},
                "IE_SEM": {"name": "Irland und Nordirland"},
                "IT-NORTH": {"name": "Italien Nord"},
                "IT-CNORTH": {"name": "Italien Mitte-Nord"},
                "IT-CSOUTH": {"name": "Italien Mitte-Süd"},
                "IT-SOUTH": {"name": "Italien Süd"},
                "IT-Calabria": {"name": "Italien Kalabrien"},
                "IT-Sardinia": {"name": "Italien Sardinien"},
                "IT-Sicily": {"name": "Italien Sizilien"},
                "NO1": {"name": "Norwegen Südost (NO1)"},
                "NO2": {"name": "Norwegen Südwest (NO2)"},
                "NO3": {"name": "Norwegen Mitte (NO3)"},
                "NO4": {"name": "Norwegen Nord (NO4)"},
                "NO5": {"name": "Norwegen West (NO5)"},
                "SE1": {"name": "Schweden Nord (SE1)"},
                "SE2": {"name": "Schweden Mitte-Nord (SE2)"},
                "SE3": {"name": "Schweden Mitte-Süd (SE3)"},
                "SE4": {"name": "Schweden Süd (SE4)"},
                "XK": {"name": "Kosovo"}
            }
        },
        "value": {
            "name": "=match(@price, {peak: 'Peak', offpeak: 'Off-Peak', negative: 'Stunden'}, 'Base')",
            "column": "=match(@price, {peak: 'peak', offpeak: 'offpeak', negative: 'negative'}, 'mean')",
            "domain": "=match(@price, {negative: literal([1, 10, 25, 50, 100])}, literal([50, 100, 150, 200, 300]))",
            "scale": {
                "type": "threshold",
                "scheme": "=match(@price, {negative: 'Blues'}, 'Reds')",
                "classes": 6
            },
            "legend": {"format": ",.0f", "classes": true, "symbol": null},
            "hover": {"format": "=match(@price, {negative: ',.1f'}, '$,.1f')"}
        },
        "label": {
            "column": "=match(@price, {peak: 'peak', offpeak: 'offpeak', negative: 'negative'}, 'mean')",
            "type": "numeric",
            "format": ",.0f"
        },
        "base": {"name": "Base", "column": "mean", "type": "numeric", "hover": {"format": "$,.1f"}},
        "peak": {"name": "Peak", "column": "peak", "type": "numeric", "hover": {"format": "$,.1f"}},
        "offpeak": {"name": "Off-Peak", "column": "offpeak", "type": "numeric", "hover": {"format": "$,.1f"}},
        "negative": {
            "name": "Negative Preise",
            "column": "negative",
            "type": "numeric",
            "hover": {"format": ",.1~f"}
        },
        "min": {"name": "Tiefster", "column": "min", "type": "numeric", "hover": {"format": "$,.1f"}},
        "max": {"name": "Höchster", "column": "max", "type": "numeric", "hover": {"format": "$,.1f"}}
    },
    "marks": [{"id": "labels", "filter": "@country == 'AT' or @country == 'DE_LU' or @country == 'FR' or @country == 'ES' or @country == 'IT-NORTH' or @country == 'PL' or @country == 'RO' or @country == 'SE3' or @country == 'FI' or @country == 'GR' or @country == 'IE_SEM' or @country == 'RS' or @country == 'NO1' or @country == 'NO3' or @country == 'NO4'"}],
    "geo": {"data": "/geo/europe-bidding-zones.json"}
}
