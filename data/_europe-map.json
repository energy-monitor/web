{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "height": "=steps(@totalWidth, {0: 340, 450: 420, 550: 500})",
    "margins": {"top": 10, "right": 10, "bottom": 10, "left": 10},
    "coord": "geo",
    "hover": {"empty": true},
    "dims": {
        "country": {
            "column": "country",
            "categories": {
                "AL": {"name": "Albanien"},
                "AD": {"name": "Andorra"},
                "BY": {"name": "Belarus"},
                "BE": {"name": "Belgien"},
                "BA": {"name": "Bosnien und Herzegowina"},
                "BG": {"name": "Bulgarien"},
                "DK": {"name": "Dänemark"},
                "DE": {"name": "Deutschland"},
                "EE": {"name": "Estland"},
                "FO": {"name": "Färöer"},
                "FI": {"name": "Finnland"},
                "FR": {"name": "Frankreich"},
                "GR": {"name": "Griechenland"},
                "IE": {"name": "Irland"},
                "IS": {"name": "Island"},
                "IT": {"name": "Italien"},
                "HR": {"name": "Kroatien"},
                "LV": {"name": "Lettland"},
                "LI": {"name": "Liechtenstein"},
                "LT": {"name": "Litauen"},
                "LU": {"name": "Luxemburg"},
                "MT": {"name": "Malta"},
                "MC": {"name": "Monaco"},
                "ME": {"name": "Montenegro"},
                "NL": {"name": "Niederlande"},
                "MK": {"name": "Nordmazedonien"},
                "NO": {"name": "Norwegen"},
                "AT": {"name": "Österreich"},
                "PL": {"name": "Polen"},
                "PT": {"name": "Portugal"},
                "MD": {"name": "Republik Moldau"},
                "RO": {"name": "Rumänien"},
                "SM": {"name": "San Marino"},
                "SE": {"name": "Schweden"},
                "CH": {"name": "Schweiz"},
                "RS": {"name": "Serbien"},
                "SK": {"name": "Slowakei"},
                "SI": {"name": "Slowenien"},
                "ES": {"name": "Spanien"},
                "CZ": {"name": "Tschechien"},
                "TR": {"name": "Türkei"},
                "UA": {"name": "Ukraine"},
                "HU": {"name": "Ungarn"},
                "VA": {"name": "Vatikanstadt"},
                "GB": {"name": "Vereinigtes Königreich"},
                "CY": {"name": "Zypern"}
            }
        },
        "value": {"legend": {"missing": {"name": "keine Daten", "color": "#DADADA"}}}
    },
    "marks": [
        {"type": "base", "id": "base", "fill": "#DADADA", "stroke": "white", "stroke-width": 1},
        {
            "type": "region",
            "id": "regions",
            "by": "country",
            "fill": "value",
            "stroke": "white",
            "stroke-width": 1,
            "highlight": {"fill-opacity": 0.75}
        },
        {
            "type": "text",
            "id": "labels",
            "by": "country",
            "fit": true,
            "overlap": false,
            "filter": {
                "country": ["AT", "DE", "FR", "ES", "IT", "PL", "RO", "SE", "FI", "GR", "IE", "IS", "NO", "TR", "UA", "RS"]
            },
            "halo": true,
            "text": "@label:formatted",
            "font-size": "=steps(@totalWidth, {0: 11, 550: 13})",
            "font-weight": "bold",
            "fill": "#222",
            "stroke-opacity": 0.8,
            "pointer-events": "none"
        }
    ],
    "geo": {
        "data": "/geo/europe.json",
        "object": "europe",
        "join": "country",
        "name": "NAME",
        "projection": {"type": "conicEquidistant", "rotate": [-20, 0], "parallels": [35, 65]}
    }
}
