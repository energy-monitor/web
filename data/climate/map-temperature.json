{
    "parent": "../_austria-map.json",
    "data": "districts.parquet",
    "title": "Temperatur",
    "subtitle": "Jahresmittel {year} bzw. Abweichung vom Mittel 1961 - 1990, in °C",
    "source": "Quelle: GeoSphere Austria (SPARTACUS, SNOWGRID-CL), 1 km Raster, Mittel über die Bezirke",
    "globals": {"indicator": "tm.anomaly"},
    "controls": [
        {
            "type": "radio",
            "global": "indicator",
            "name": "Werte",
            "values": [{"value": "tm", "name": "Jahresmittel"}, {"value": "tm.anomaly", "name": "Abweichung"}]
        }
    ],
    "dims": {
        "value": {
            "name": "=match(@indicator, {tm: 'Jahresmittel in °C'}, 'Abweichung in °C')",
            "format": "=match(@indicator, {tm: '.1f'}, '+.1f')",
            "domain": "=match(@indicator, {tm: literal([0, 14])}, literal([3, -3]))",
            "scale": {"type": "sequential", "interpolator": "=match(@indicator, {tm: 'YlOrRd'}, 'RdBu')"},
            "legend": {"format": "=match(@indicator, {tm: '.0f'}, '+.1f')"}
        }
    }
}
