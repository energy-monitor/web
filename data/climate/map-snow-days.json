{
    "parent": "../_austria-map.json",
    "data": "districts.parquet",
    "options": {
        "title": "Schneedeckentage",
        "subtitle": "Tage mit mindestens 1 cm Schnee, jährlich, bzw. Abweichung vom Mittel 1961 - 1990",
        "footer": "Quelle: GeoSphere Austria (SPARTACUS, SNOWGRID-CL), 1 km Raster, Mittel über die Bezirke"
    },
    "globals": { "indicator": "days.snow" },
    "formElements": [
        {
            "id": "indicator",
            "name": "Werte",
            "ref": "indicator",
            "type": "radio",
            "values": [
                { "id": "absolute", "name": "Tage", "value": "days.snow" },
                {
                    "id": "anomaly",
                    "name": "Abweichung",
                    "value": "days.snow.anomaly",
                    "patch": {
                        "mapping": {
                            "value": {
                                "name": "Abweichung in Tagen",
                                "domain": [-80, 80],
                                "scale": { "interpolator": "RdBu" },
                                "legend": { "format": "+.0f" },
                                "hover": { "format": "+.0f" }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "mapping": {
        "value": {
            "name": "Tage",
            "domain": [0, 250],
            "scale": { "type": "sequential", "interpolator": "Blues" },
            "legend": { "format": ".0f" },
            "hover": { "format": ".0f" }
        }
    }
}
