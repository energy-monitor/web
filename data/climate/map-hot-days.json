{
    "parent": "../_austria-map.json",
    "data": "districts.parquet",
    "title": "Hitzetage",
    "subtitle": "Tage mit Höchsttemperatur ≥ 30 °C, {year}, bzw. Abweichung vom Mittel 1961 - 1990",
    "source": "Quelle: GeoSphere Austria (SPARTACUS, SNOWGRID-CL), 1 km Raster, Mittel über die Bezirke",
    "globals": {"indicator": "days.hot"},
    "controls": [
        {
            "type": "radio",
            "global": "indicator",
            "name": "Werte",
            "id": "indicator",
            "values": [
                {"id": "absolute", "name": "Tage", "value": "days.hot"},
                {"id": "anomaly", "name": "Abweichung", "value": "days.hot.anomaly"}
            ]
        }
    ],
    "dims": {
        "label": {
            "column": "value",
            "type": "numeric",
            "format": "=match(@indicator, {'days.hot.anomaly': '+.0f'}, '.0f')"
        },
        "value": {
            "name": "=match(@indicator, {'days.hot.anomaly': 'Abweichung in Tagen'}, 'Hitzetage')",
            "domain": "=match(@indicator, {'days.hot.anomaly': literal([30, -30])}, literal([0, 40]))",
            "scale": {
                "type": "sequential",
                "interpolator": "=match(@indicator, {'days.hot.anomaly': 'RdBu'}, 'Reds')"
            },
            "legend": {"format": "=match(@indicator, {'days.hot.anomaly': '+.0f'}, '.0f')", "symbol": null},
            "hover": {"format": "=match(@indicator, {'days.hot.anomaly': '+.0f'}, '.0f')"}
        }
    },
    "hover": {"columns": []}
}
