{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "parent": "../_austria-map.json",
    "data": "districts.parquet",
    "options": {
        "title": "Hitzetage",
        "subtitle": "Tage mit Höchsttemperatur ≥ 30 °C, {year}, bzw. Abweichung vom Mittel 1961 - 1990",
        "footer": "Quelle: GeoSphere Austria (SPARTACUS, SNOWGRID-CL), 1 km Raster, Mittel über die Bezirke"
    },
    "globals": { "indicator": "days.hot" },
    "formElements": [
        {
            "id": "indicator",
            "name": "Werte",
            "ref": "indicator",
            "type": "radio",
            "values": [
                { "id": "absolute", "name": "Tage", "value": "days.hot" },
                {
                    "id": "anomaly",
                    "name": "Abweichung",
                    "value": "days.hot.anomaly",
                    "patch": {
                        "mapping": { "label": { "format": "+.0f" },
                            "value": {
                                "name": "Abweichung in Tagen",
                                "domain": [30, -30],
                                "scale": { "interpolator": "RdBu" },
                                "legend": { "format": "+.0f" },
                                "hover": { "format": "+.0f" }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "mapping": {
        "label": { "column": "value", "type": "numeric", "format": ".0f" },
        "value": {
            "name": "Hitzetage",
            "domain": [0, 40],
            "scale": { "type": "sequential", "interpolator": "Reds" },
            "legend": { "format": ".0f" },
            "hover": { "format": ".0f" }
        }
    }
}
