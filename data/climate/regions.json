{
    "parent": "../_timeline.json",
    "data": "regions.csv",
    "options": {
        "height": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [
                {"cut":   0, "value": 250},
                {"cut": 550, "value": 280},
                {"cut": 600, "value": 320}
            ]
        },
        "margins": {"top": 5, "right": 30, "bottom": 30, "left": 50},
        "title": "Klimaindikatoren nach Bundesland",
        "subtitle": "jährlich, Flächenmittel",
        "footer": "Quelle: GeoSphere Austria (SPARTACUS, SNOWGRID-CL), 1 km Raster"
    },
    "globals": {
        "indicator": "tm"
    },
    "filter": { "indicator": "@indicator" },
    "formElements": [{
        "id": "indicator", "name": "Indikator", "ref": "indicator", "type": "radio",
        "values": [
            { "id": "tm",         "name": "Temperatur (°C)",            "value": "tm" },
            { "id": "tm.anomaly", "name": "Temperatur, Abweichung 1961 - 1990 (°C)", "value": "tm.anomaly" },
            { "id": "rr",         "name": "Niederschlag (mm)",          "value": "rr" },
            { "id": "sa",         "name": "Sonnenstunden",              "value": "sa" },
            { "id": "days.hot",   "name": "Hitzetage (≥ 30 °C)",        "value": "days.hot" },
            { "id": "days.hot.anomaly", "name": "Hitzetage, Abweichung 1961 - 1990", "value": "days.hot.anomaly" },
            { "id": "days.frost", "name": "Frosttage (< 0 °C)",         "value": "days.frost" },
            { "id": "days.snow",  "name": "Schneedeckentage (≥ 1 cm)",  "value": "days.snow" },
            { "id": "days.snow.anomaly", "name": "Schneedeckentage, Abweichung 1961 - 1990", "value": "days.snow.anomaly" },
            { "id": "swe.max",    "name": "Max. Schneewasseräquivalent (mm)", "value": "swe.max" }
        ]
    }],
    "mapping": {
        "x": {
            "axis": {
                "ticks": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.014
                },
                "rotate": 0,
                "format": "%Y"
            },
            "hover": { "format": "%Y" }
        },
        "y": {
            "scale": { "type": "linear", "domain": [null, null], "domainRel": [-0.05, 0.05] },
            "axis": { "format": ",.0f" },
            "hover": { "format": ",.1f" }
        },
        "indicator": { "column": "indicator" },
        "type": {
            "column": "type",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "line",
                        "props": {
                            "x1": 0, "x2": 16, "y1": 8, "y2": 8,
                            "stroke": "@color",
                            "stroke-width": "@stroke-width",
                            "opacity": "@opacity"
                        }
                    }]
                }
            },
            "props": {
                "common": {
                    "stroke-width": 1.5,
                    "highlight-stroke-width": 3,
                    "opacity": 0.8,
                    "highlight-opacity": 1
                },
                "categories": {
                    "AT": { "color": "#000000", "name": "Österreich", "stroke-width": 2.5 },
                    "1":  { "color": "#e6194b", "name": "Burgenland" },
                    "2":  { "color": "#3cb44b", "name": "Kärnten" },
                    "3":  { "color": "#4363d8", "name": "Niederösterreich" },
                    "4":  { "color": "#f58231", "name": "Oberösterreich" },
                    "5":  { "color": "#911eb4", "name": "Salzburg" },
                    "6":  { "color": "#42d4f4", "name": "Steiermark" },
                    "7":  { "color": "#f032e6", "name": "Tirol" },
                    "8":  { "color": "#9A6324", "name": "Vorarlberg" },
                    "9":  { "color": "#808000", "name": "Wien" }
                }
            }
        }
    },
    "plot": {
        "type": "cartesian:line",
        "categories": ["type"],
        "props": {
            "stroke-width": "@stroke-width",
            "fill": "none",
            "opacity": "@opacity",
            "stroke": "@color",
            "d": {
                "x": "@x:scaled",
                "y": "@y:scaled"
            },
            "highlight-opacity": "@highlight-opacity",
            "highlight-stroke-width": "@highlight-stroke-width"
        }
    }
}
