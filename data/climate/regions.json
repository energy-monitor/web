{
    "parent": "../_timeline.json",
    "data": "regions.parquet",
    "title": "Klimaindikatoren nach Bundesland",
    "subtitle": "jährlich, Flächenmittel",
    "source": "Quelle: GeoSphere Austria (SPARTACUS, SNOWGRID-CL), 1 km Raster",
    "height": "=steps(@totalWidth, {0: 250, 550: 280, 600: 320})",
    "globals": {"indicator": "tm", "values": "abs"},
    "controls": [
        {
            "type": "radio",
            "global": "indicator",
            "name": "Indikator",
            "values": [
                {"value": "tm", "name": "Temperatur (°C)"},
                {"value": "rr", "name": "Niederschlag (mm, Abweichung in %)"},
                {"value": "sa", "name": "Sonnenstunden"},
                {"value": "days.hot", "name": "Hitzetage (≥ 30 °C)"},
                {"value": "days.frost", "name": "Frosttage (< 0 °C)"},
                {"value": "days.snow", "name": "Schneedeckentage (≥ 1 cm)"},
                {"value": "swe.max", "name": "Max. Schneewasseräquivalent (mm, Abweichung in %)"}
            ]
        },
        {
            "type": "radio",
            "global": "values",
            "name": "Werte",
            "values": [
                {"value": "abs", "name": "Absolut"},
                {"value": "anomaly", "name": "Abweichung vom Mittel 1961 - 1990"}
            ]
        }
    ],
    "filter": {"indicator": "@globals.indicator"},
    "dims": {
        "x": {"format": "%Y", "tickSpacing": 71, "axis": {"rotate": 0}},
        "y": {
            "column": "=match(@values, {anomaly: 'value.anomaly'})",
            "zero": false,
            "pad": 0.05,
            "axis": {"format": "=match(@values, {anomaly: '+,~f'}, ',.0f')"},
            "hover": {"format": "=match(@values, {anomaly: '+,.1f'}, ',.1f')"}
        },
        "indicator": "indicator",
        "type": {
            "column": "type",
            "legend": {},
            "common": {"stroke-width": 1.5},
            "categories": {
                "1": {"name": "Burgenland", "color": "#e6194b"},
                "2": {"name": "Kärnten", "color": "#3cb44b"},
                "3": {"name": "Niederösterreich", "color": "#4363d8"},
                "4": {"name": "Oberösterreich", "color": "#f58231"},
                "5": {"name": "Salzburg", "color": "#911eb4"},
                "6": {"name": "Steiermark", "color": "#42d4f4"},
                "7": {"name": "Tirol", "color": "#f032e6"},
                "8": {"name": "Vorarlberg", "color": "#9A6324"},
                "9": {"name": "Wien", "color": "#808000"},
                "AT": {"name": "Österreich", "color": "#000000", "stroke-width": 2.5}
            }
        }
    },
    "marks": {
        "type": "line",
        "by": "type",
        "curve": "monotoneX",
        "stroke-width": "@stroke-width",
        "opacity": 0.8,
        "highlight": {"opacity": 1, "stroke-width": 3}
    },
    "hover": {"columns": []}
}
