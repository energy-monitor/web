{
    "parent": ["_supply.json", "../_scale-switch.json"],
    "data": "supply.csv",
    "options": {
        "title": "Absatz von fossilen Energieträgern",
        "subtitle": "nach Emissionen in Megatonnen CO₂",
        "footer": "Source: eurostat, eigene Berechnungen"
    },
    "globals": {
        "shareScale": ["x", "y"]
    },
    "mapping": {
        "y": {
            "column": "mt.co2"
        },
        "facet": {
            "props": {
                "manual": {
                    "oil":  { "name": "Mineralöl", "visible": true },
                    "coal": { "name": "Kohle", "visible": true },
                    "gas":  { "name": "Erdgas", "visible": true }
                }
            }
        }
    },
    "facets": {
        "cols": {
            "steps": [
                {"cut":   0, "value": 1},
                {"cut": 550, "value": 3}
            ]
        }
    }
}
