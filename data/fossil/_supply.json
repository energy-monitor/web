{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "parent": ["../_years.json", "../_facets.json", "../_facet-toggle.json", "../_monthly.json"],
    "options": { "height": 220 },
    "mapping": {
        "y": { "axis": { "format": ",.0f" }, "hover": { "format": ",.2f" } },
        "year": { "categories": { "avg14-18": { "color": "#444", "name": "Ø '14 - '18" } } },
        "facet": { "column": "product" }
    },
    "facets": { "cols": { "steps": ["@totalWidth", { "0": 1, "550": 2 }] } }
}
