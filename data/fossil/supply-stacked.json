{
    "parent": ["../_stacked.json", "_unit-switch.json"],
    "data": "supply-stacked.parquet",
    "title": "Absatz von fossilen Energieträgern",
    "subtitle": "monatlich, nach Energiegehalt in TWh bzw. Emissionen in Mt CO₂, oder Anteile",
    "source": "Quelle: eurostat, eigene Berechnungen",
    "globals": {"share": ""},
    "controls": [
        {
            "type": "radio",
            "global": "share",
            "name": "Werte",
            "values": [
                {"id": "valuesAbs", "value": "", "name": "Absolut"},
                {"id": "valuesShare", "value": ".share", "name": "Anteil"}
            ]
        }
    ],
    "dims": {
        "y": {
            "column": "{unit}{share}",
            "domain": "=match(@share, {'.share': literal([0, 1])})",
            "pad": "=match(@share, {'.share': literal([0, 0])})",
            "axis": {"format": "=match(@share, {'.share': '.0%'})"},
            "hover": {"format": "=match(@share, {'.share': '.1%'}, ',.2f')"}
        },
        "type": {
            "column": "product",
            "categories": {
                "oil": {"color": "#6F625A", "name": "Mineralöl"},
                "coal": {"color": "#8B4513", "name": "Kohle"},
                "gas": {"color": "#C3423F", "name": "Erdgas"}
            }
        }
    }
}
