{
    "parent": ["_supply.json", "_unit-switch.json", "../_scale-switch.json"],
    "data": "supply.parquet",
    "title": "Absatz von fossilen Energieträgern im Jahresvergleich",
    "subtitle": "nach Energiegehalt in TWh bzw. Emissionen in Megatonnen CO₂",
    "source": "Quelle: eurostat, eigene Berechnungen",
    "globals": {"shareScale": ["x", "y"]},
    "dims": {
        "y": {"column": "{unit}"},
        "facet": {
            "categories": {
                "total": {"name": "Gesamt", "visible": true},
                "oil": {"name": "Mineralöl", "visible": true},
                "coal": {"name": "Kohle", "visible": true},
                "gas": {"name": "Erdgas", "visible": true}
            }
        }
    }
}
