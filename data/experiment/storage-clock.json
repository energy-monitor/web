{
    "parent": "../_years.json",
    "data": "../gas/storage.parquet",
    "title": "Gasspeicher",
    "subtitle": "Füllstand der österreichischen Gasspeicher, das Jahr im Uhrzeigersinn, Jänner oben, in TWh",
    "source": "Quelle: GIE – Gas Infrastructure Europe",
    "height": "=steps(@totalWidth, {0: 340, 600: 460})",
    "margins": {"top": 30, "right": 40, "left": 40},
    "coord": "polar",
    "class": "polar-chart",
    "filter": "@type == 'stock'",
    "dims": {
        "x": {
            "format": "%b",
            "domain": ["2020-01-01", "2021-01-01"],
            "ticks": 12,
            "grid": true,
            "axis": {
                "labels": {"curved": "between"},
                "domain": {"props": {"stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75}},
                "tickMarks": {"props": {"stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75}}
            }
        },
        "y": {
            "zero": true,
            "nice": true,
            "pad": 0,
            "ticks": 4,
            "grid": true,
            "axis": {
                "angle": 0,
                "format": ",.0f",
                "labels": {"props": {"fill": "#777", "font-size": 10}},
                "domain": {"props": {"stroke": "none"}}
            },
            "hover": {"format": ",.1f"},
            "range": ["@radius * 0.12", "@radius"]
        },
        "year": {"legend": {"symbol": "line"}}
    },
    "marks": [
        {
            "type": "line",
            "id": "lines",
            "by": "year",
            "stroke-width": 2,
            "opacity": "@opacity",
            "highlight": {"opacity": 1, "stroke-width": 3},
            "others": {"opacity": 0.1}
        },
        {
            "type": "point",
            "id": "now",
            "by": "year",
            "select": "last",
            "r": 3.5,
            "stroke": "white",
            "opacity": "@opacity",
            "others": {"opacity": 0.1}
        }
    ]
}
