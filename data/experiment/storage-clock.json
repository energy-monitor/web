{
    "parent": "../_years.json",
    "data": "../gas/storage.parquet",
    "options": {
        "coord": "polar",
        "class": "polar-chart",
        "title": "Gasspeicher",
        "subtitle": "Füllstand der österreichischen Gasspeicher, das Jahr im Uhrzeigersinn, Jänner oben, in TWh",
        "footer": "Quelle: GIE – Gas Infrastructure Europe",
        "height": { "steps": ["@totalWidth", { "0": 340, "600": 460 }] },
        "margins": { "top": 30, "right": 40, "bottom": 30, "left": 40 }
    },
    "filter": { "type": "stock" },
    "mapping": {
        "type": { "column": "type", "type": "categorical" },
        "x": {
            "domain": ["2020-01-01", "2021-01-01"],
            "format": "%b",
            "scale": { "type": "time", "domainAbs": [0, 0] },
            "axis": {
                "ticks": 12,
                "grid": true,
                "labels": { "curved": "between" },
                "domain": {
                    "props": { "stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75 }
                },
                "tickMarks": {
                    "props": { "stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75 }
                }
            }
        },
        "y": {
            "domain": [0, null],
            "nice": true,
            "scale": { "domainRel": [0, 0], "range": [{ "*": ["@radius", 0.12] }, "@radius"] },
            "axis": {
                "angle": 0,
                "ticks": 4,
                "grid": true,
                "format": ",.0f",
                "labels": { "props": { "fill": "#777", "font-size": 10 } },
                "domain": { "props": { "stroke": "none" } }
            },
            "hover": { "format": ",.1f" }
        }
    },
    "plot": [
        {
            "id": "lines",
            "type": "line",
            "by": "year",
            "props": { "stroke": "@color", "stroke-width": "@stroke-width", "opacity": "@opacity" },
            "highlight": { "opacity": 1, "stroke-width": 3 },
            "others": { "opacity": 0.1 }
        },
        {
            "id": "now",
            "type": "point",
            "by": "year",
            "select": "last",
            "props": { "r": 3.5, "fill": "@color", "stroke": "white", "opacity": "@opacity" },
            "others": { "opacity": 0.1 }
        }
    ]
}
