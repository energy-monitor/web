{
    "parent": "../_years.json",
    "data": "../gas/storage.parquet",
    "options": {
        "coord": "polar",
        "class": "polar-chart",
        "title": "Gasspeicher",
        "subtitle": "Füllstand der österreichischen Gasspeicher, das Jahr im Uhrzeigersinn, Jänner oben, in TWh",
        "footer": "Quelle: GIE – Gas Infrastructure Europe",
        "height": { "prop": "steps", "ref": "totalWidth", "steps": [{ "cut": 0, "value": 340 }, { "cut": 600, "value": 460 }] },
        "margins": {"top": 30, "right": 40, "bottom": 30, "left": 40}
    },
    "filter": { "type": "stock" },
    "mapping": {
        "type": { "column": "type", "type": "categorical" },
        "x": {
            "scale": { "type": "time", "orientation": "angular", "domain": ["2020-01-01", "2021-01-01"], "domainAbs": [0, 0] },
            "axis": {
                "position": "angular", "ticks": 12, "format": "%b", "grid": true,
                "labels": { "curved": "between" },
                "domain": { "props": { "stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75 } },
                "tickMarks": { "props": { "stroke": "var(--gen-vis-grid-color)", "stroke-width": 0.75 } }
            }
        },
        "y": {
            "scale": { "orientation": "radial", "domain": [0, null], "domainRel": [0, 0], "nice": true, "range": [{ "prop": "relative", "ref": "radius", "ratio": 0.12 }, "@radius"] },
            "axis": {
                "position": "radial", "angle": 0, "ticks": 4, "grid": true, "format": ",.0f",
                "labels": { "props": { "fill": "#777", "font-size": 10 } },
                "domain": { "props": { "stroke": "none" } }
            },
            "hover": { "format": ",.1f" }
        }
    },
    "plot": [
        {
            "id": "lines",
            "type": "polar:line",
            "categories": ["year"],
            "props": {
                "d": { "angle": "@x:scaled", "radius": "@y:scaled" },
                "stroke": "@color", "stroke-width": "@stroke-width", "opacity": "@opacity", "fill": "none",
                "highlight-opacity": 1, "highlight-stroke-width": 3, "others-opacity": 0.1
            }
        },
        {
            "id": "now",
            "type": "polar:circle",
            "categories": ["year"],
            "select": "last",
            "props": { "angle": "@x:scaled", "radius": "@y:scaled", "r": 3.5, "fill": "@color", "stroke": "white", "opacity": "@opacity", "others-opacity": 0.1 }
        }
    ]
}
