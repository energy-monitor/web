{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "height": "=steps(@totalWidth, {0: 220, 550: 250, 600: 280})",
    "dims": {
        "x": {
            "column": "date20",
            "type": "date",
            "pad": 0,
            "tickSpacing": 59,
            "axis": {"format": "%b"},
            "hover": {"format": "%e. %b"}
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "zero": true,
            "pad": [0, 0.1],
            "ticks": 6,
            "grid": true,
            "axis": {"format": ",.0f"},
            "hover": {"format": ",.1f"}
        },
        "year": {
            "column": "year",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 16,
                                "y1": 8,
                                "y2": 8,
                                "stroke": "@color",
                                "stroke-width": "@stroke-width",
                                "opacity": "@opacity"
                            }
                        }
                    ]
                }
            },
            "common": {"stroke-width": 2, "highlight-stroke-width": 3, "opacity": 0.6, "highlight-opacity": 1},
            "categories": {
                "2019": {"color": "#BBBBBB", "opacity": 0.2},
                "2020": {"color": "#AAAAAA", "opacity": 0.2},
                "2021": {"color": "#cf90f0", "opacity": 0.2},
                "2022": {"color": "#86cae7", "opacity": 0.2},
                "2023": {"color": "#b5c969", "opacity": 0.5},
                "2024": {"color": "#f3d039", "opacity": 0.6},
                "2025": {"color": "#cf8e02", "opacity": 0.7},
                "2026": {"color": "#c3423f", "opacity": 1}
            }
        }
    },
    "marks": {
        "type": "line",
        "by": "year",
        "stroke-width": "@stroke-width",
        "opacity": "@opacity",
        "highlight": {"opacity": "@highlight-opacity", "stroke-width": "@highlight-stroke-width"}
    }
}
