{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "options": {
        "coord": "geo",
        "height": { "steps": ["@totalWidth", { "0": 260, "450": 320, "550": 380 }] },
        "margins": { "top": 10, "right": 10, "bottom": 10, "left": 10 },
        "hover": { "empty": true }
    },
    "geo": {
        "data": "/geo/austria-districts.json",
        "object": "districts",
        "key": "id",
        "join": "district",
        "name": "NAME",
        "projection": { "type": "conicEquidistant", "rotate": [-13.3, 0], "parallels": [46, 49] }
    },
    "globals": { "year": "2025" },
    "filter": { "indicator": "@indicator", "year": "@year" },
    "formElements": [
        {
            "id": "year",
            "name": "Jahr",
            "ref": "year",
            "type": "slider",
            "values": { "column": "year" }
        }
    ],
    "mapping": {
        "district": { "column": "district", "type": "categorical" },
        "indicator": { "column": "indicator", "type": "categorical" },
        "year": { "column": "year", "type": "categorical" },
        "value": {
            "column": "value",
            "type": "numeric",
            "legend": { "missing": { "name": "keine Daten", "color": "#DADADA" } }
        }
    },
    "plot": [
        {
            "type": "geo:base",
            "props": { "fill": "#DADADA", "stroke": "white", "stroke-width": 0.5 }
        },
        {
            "type": "geo:region",
            "by": "district",
            "props": { "fill": "@value:scaled", "stroke": "white", "stroke-width": 0.5 },
            "highlight": { "fill-opacity": 0.75 }
        },
        {
            "type": "geo:mesh",
            "object": "states",
            "borders": "inner",
            "props": { "stroke": "white", "stroke-width": 1.4 }
        },
        {
            "type": "geo:text", "by": "district",
            "filter": { "district": ["706", "707", "206", "612", "325", "316", "900", "601", "401", "501", "701", "201", "101", "802", "302"] },
            "fit": false,
            "overlap": false,
            "props": {
                "text": "@label:formatted", "font-size": { "steps": ["@totalWidth", { "0": 8, "450": 9, "550": 10 }] }, "font-weight": "bold", "text-anchor": "middle", "dominant-baseline": "middle",
                "fill": "#222", "stroke": "white", "stroke-width": 3, "stroke-opacity": 0.8, "paint-order": "stroke",
                "pointer-events": "none"
            }
        }
    ]
}
