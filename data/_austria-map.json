{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "height": "=steps(@totalWidth, {0: 260, 450: 320, 550: 380})",
    "margins": {"top": 10, "right": 10, "bottom": 10, "left": 10},
    "coord": "geo",
    "hover": {"empty": true},
    "globals": {"year": "2025"},
    "controls": [{"type": "slider", "global": "year", "name": "Jahr", "values": {"column": "year"}}],
    "filter": {"indicator": "@globals.indicator", "year": "@globals.year"},
    "dims": {
        "district": {"column": "district", "type": "categorical"},
        "indicator": "indicator",
        "year": "year",
        "value": {
            "column": "value",
            "hover": {},
            "legend": {"missing": {"name": "keine Daten", "color": "#DADADA"}}
        }
    },
    "marks": [
        {"type": "base", "fill": "#DADADA", "stroke": "white", "stroke-width": 0.5},
        {
            "type": "region",
            "by": "district",
            "fill": "value",
            "stroke": "white",
            "stroke-width": 0.5,
            "highlight": {"fill-opacity": 0.75}
        },
        {
            "type": "mesh",
            "object": "states",
            "borders": "inner",
            "stroke": "white",
            "stroke-width": 1.4
        },
        {
            "type": "text",
            "by": "district",
            "fit": false,
            "overlap": false,
            "filter": {
                "district": [706, 707, 206, 612, 325, 316, 900, 601, 401, 501, 701, 201, 101, 802, 302]
            },
            "halo": true,
            "text": "@value:formatted",
            "font-size": "=steps(@totalWidth, {0: 8, 450: 9, 550: 10})",
            "font-weight": "bold",
            "fill": "#222",
            "stroke-opacity": 0.8,
            "pointer-events": "none"
        }
    ],
    "geo": {
        "data": "/geo/austria-districts.json",
        "object": "districts",
        "join": "district",
        "name": "NAME",
        "projection": {"type": "conicEquidistant", "rotate": [-13.3, 0], "parallels": [46, 49]}
    }
}
