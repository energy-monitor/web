    "parent": ["../fossil/_supply.json", "../_scale-switch.json"],
    "data": "supply.parquet",
    "options": {
        "title": "Absatz von Kohle im Jahresvergleich",
        "subtitle": "in tausend Tonnen",
        "footer": "Quelle: eurostat - nrg_cb_sffm"
    },
    "globals": { "shareScale": ["x", "y"] },
