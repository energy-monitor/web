{
    "parent": ["../_timeline.json", "../_facets.json", "../_facet-toggle.json", "../_scale-switch.json"],
    "data": "estimate.parquet",
    "title": "CO₂-Emissionen fossiler Brennstoffe: Inventur und Schätzung",
    "subtitle": "in Mt CO₂, Schätzung als Summe der letzten 12 Monate, Inventur jährlich (beim Dezember), Kohle laut Referenzansatz inkl. gespeichertem Kohlenstoff, ohne internationalen Flugverkehr, AT",
    "source": "Quelle: Umweltbundesamt - Treibhausgasinventur, eurostat, eigene Berechnungen; Methode für Gas und Öl nach <a href=\"https://github.com/ElijahStaengl/co2-emissions-austria\" target=\"_blank\">Elijah Stängl</a>",
    "height": 220,
    "dims": {
        "x": {"axis": {"ticks": null, "tickSpacing": 60, "rotate": 0, "format": "%Y"}},
        "y": {"hover": {"format": ",.2f"}},
        "type": {
            "column": "type",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 16,
                                "y1": 8,
                                "y2": 8,
                                "stroke": "@stroke",
                                "stroke-width": 2
                            }
                        },
                        {"type": "circle", "props": {"cx": 8, "cy": 8, "r": "@r", "fill": "@color"}}
                    ]
                }
            },
            "categories": {
                "estimate": {"color": "#C3423F", "name": "Schätzung", "stroke": "#C3423F", "r": 0},
                "inventory": {"color": "#444444", "name": "Inventur", "stroke": "none", "r": 3}
            }
        },
        "facet": {
            "column": "facet",
            "categories": {
                "total": {"name": "Gesamt"},
                "oil": {"name": "Mineralöl"},
                "gas": {"name": "Erdgas"},
                "coal": {"name": "Kohle"}
            }
        }
    },
    "marks": [
        {
            "type": "line",
            "by": ["type", "facet"],
            "stroke": "@stroke",
            "stroke-width": 2,
            "highlight": {"stroke-width": 3}
        },
        {"type": "point", "by": ["type", "facet"], "r": "@r", "fill": "@color"}
    ],
    "facets": {"cols": "=steps(@totalWidth, {0: 1, 550: 2})"}
}
