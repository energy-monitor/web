{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "parent": "../_share-switch.json",
    "options": {
        "height": { "steps": ["@totalWidth", { "0": 220, "550": 260, "600": 300 }] },
        "margins": { "top": 15, "right": 30, "bottom": 30, "left": 50 },
        "footer": "Quelle: Umweltbundesamt - Treibhausgasinventur (Submission 2026 an die UNFCCC)"
    },
    "mapping": {
        "x": {
            "column": "year",
            "type": "categorical",
            "scale": { "padding": 0.4 },
            "axis": { "values": ["1990", "1995", "2000", "2005", "2010", "2015", "2020"] }
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "domain": [0, null],
            "stacked": true,
            "scale": { "domainRel": [0, 0.1] },
            "axis": { "ticks": 6, "grid": true, "format": ",.0f" },
            "hover": { "format": ",.1f" }
        },
        "type": {
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {
                                "x": 0,
                                "y": 0,
                                "width": 16,
                                "height": 15,
                                "fill": "@color",
                                "rx": 2
                            }
                        }
                    ]
                }
            },
            "hover": {}
        }
    },
    "plot": {
        "type": "bar",
        "by": "type",
        "props": {
            "fill": "@color",
            "opacity": 0.9,
            "y0": "@y:start:scaled",
            "y1": "@y:end:scaled"
        },
        "highlight": { "mode": "row", "opacity": 1 }
    }
}
