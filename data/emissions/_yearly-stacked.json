{
    "parent": "../_share-switch.json",
    "source": "Quelle: Umweltbundesamt - Treibhausgasinventur (Submission 2026 an die UNFCCC)",
    "height": "=steps(@totalWidth, {0: 220, 550: 260, 600: 300})",
    "margins": {"top": 15, "right": 30, "bottom": 30, "left": 50},
    "dims": {
        "x": {
            "column": "year",
            "type": "categorical",
            "scale": {"padding": 0.4},
            "axis": {"values": ["1990", "1995", "2000", "2005", "2010", "2015", "2020"]}
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "zero": true,
            "pad": [0, 0.1],
            "ticks": 6,
            "grid": true,
            "axis": {"format": ",.0f"},
            "hover": {"format": ",.1f"}
        },
        "type": {
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {"x": 0, "y": 0, "width": 16, "height": 15, "fill": "@color", "rx": 2}
                        }
                    ]
                }
            },
            "hover": {}
        }
    },
    "marks": {
        "type": "bar",
        "by": "type",
        "stack": true,
        "opacity": 0.9,
        "highlight": {"mode": "row", "opacity": 1}
    },
    "hover": {"columns": []}
}
