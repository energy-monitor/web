{
    "parent": "../_timeline.json",
    "data": "price-index.parquet",
    "title": "Preisindex der Energieträger",
    "subtitle": "Preise in €, monatlich, Durchschnitt {base} = 100, logarithmische Skala",
    "source": "Quelle: cismo (Gas, CEGH), Macrobond, ICE (Brent, Kohle, EUA), ENTSO-E (Strom), Statistik Austria (Brennholz), proPellets Austria (Pellets); Brent und Kohle von $ umgerechnet",
    "height": "=steps(@totalWidth, {0: 250, 550: 280, 600: 320})",
    "margins": {"right": 140},
    "globals": {"base": "2019"},
    "controls": [
        {
            "type": "slider",
            "global": "base",
            "name": "Basisjahr",
            "values": {"column": "base"},
            "inImage": false
        }
    ],
    "filter": {"base": "@globals.base"},
    "dims": {
        "x": {"tickSpacing": 71, "axis": {"rotate": 0, "format": "%Y"}},
        "y": {
            "zero": false,
            "pad": 0.05,
            "scale": {"type": "log"},
            "axis": {"values": [2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000]}
        },
        "base": "base",
        "type": {
            "column": "type",
            "legend": {},
            "categories": {
                "gas": {"name": "Erdgas", "color": "#C3423F"},
                "oil": {"name": "Rohöl (Brent)", "color": "#C3423F", "stroke-dasharray": "6, 3"},
                "coal": {"name": "Kohle", "color": "#C3423F", "stroke-dasharray": "2, 2"},
                "firewood": {"name": "Brennholz", "color": "#b5c969"},
                "pellets": {
                    "name": "Pellets",
                    "color": "#b5c969",
                    "stroke-dasharray": "6, 3",
                    "visible": false
                },
                "electricity": {"name": "Strom", "color": "#86cae7"},
                "eua": {
                    "name": "CO₂-Zertifikate (EUA)",
                    "color": "#F3D039",
                    "stroke-dasharray": "6, 3",
                    "visible": false
                }
            }
        }
    },
    "marks": [
        {
            "type": "line",
            "id": "lines",
            "by": "type",
            "curve": "monotoneX",
            "stroke-width": 2,
            "stroke-dasharray": "@stroke-dasharray",
            "opacity": 0.7,
            "highlight": {"opacity": 1, "stroke-width": 3}
        },
        {
            "type": "text",
            "id": "names",
            "by": "type",
            "select": {"max": "x"},
            "x": "@x:scaled:max",
            "dx": 6,
            "dodge": 14,
            "halo": true,
            "text": "@name",
            "fill": "@color",
            "font-size": 12,
            "font-weight": "bold",
            "dominant-baseline": "central",
            "highlight": {"opacity": 1},
            "others": {"opacity": 0.35}
        }
    ],
    "annotations": [{"type": "line", "y": 100, "props": {"stroke": "#999", "stroke-dasharray": "3 3"}}]
}
