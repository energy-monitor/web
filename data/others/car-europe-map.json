{
    "title": "Pkw in Europa",
    "subtitle": "Anteile nach Kraftstoffart bzw. Energiequelle, jährlich",
    "footer": "Source: eurostat - road_eqr_carpda (Neuzulassungen), road_eqs_carpda (Bestand)",
    "series": {
        "name": "Daten",
        "values": {
            "registrations": { "name": "Neuzulassungen", "data": "car-registrations-europe.csv" },
            "stock":         { "name": "Bestand",        "data": "car-stock-europe.csv" }
        }
    },
    "yearSelect": true,
    "types": {
        "name": "Kraftstoff",
        "values": {
            "bev":    { "name": "Elektro",               "range": ["#9bcda3", "#2c7340"] },
            "phev":   { "name": "Plug-in-Hybrid",        "range": ["#b8e4d6", "#55907f"] },
            "hybrid": { "name": "Hybrid (ohne Plug-in)", "range": ["#a3c4e8", "#346994"] },
            "petrol": { "name": "Benzin",                "range": ["#feca95", "#a9702b"] },
            "diesel": { "name": "Diesel",                "range": ["#ada5a0", "#4e453f"] },
            "other":  { "name": "Sonstige",              "range": ["#ececec", "#7d7d7d"] }
        }
    },
    "domain": [0, null],
    "scale": "sqrt",
    "format": ".1%",
    "legendFormat": ".2~%",
    "count": { "column": "value", "format": ",.0f", "unit": "Pkw" }
}
