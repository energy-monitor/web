{
    "data": "emissions-nid.csv",
    "options": {
        "height": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [
                {"cut":   0, "value": 220},
                {"cut": 550, "value": 260},
                {"cut": 600, "value": 300}
            ]
        },
        "margins": {"top": 5, "right": 30, "bottom": 45, "left": 50},
        "title": "Abweichung von der Treibhausgas-Inventur",
        "subtitle": "Eigene Berechnung der CO₂-Emissionen im Vergleich zur NID, pro Jahr, in %",
        "footer": "Source: eurostat; Umweltbundesamt - NID 2026, Treibhausgas-Emissionen nach CRT; eigene Berechnungen"
    },
    "mapping": {
        "x": {
            "column": "date",
            "type": "date",
            "scale": {
                "type": "time",
                "orientation": "horizontal",
                "domainAbs": [-15000000000, 15000000000]
            },
            "axis": {
                "ticks": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.017
                },
                "label": "Year",
                "position": "bottom",
                "rotate": 0,
                "format": "%Y"
            },
            "hover": {
                "format": "%Y"
            }
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "orientation": "vertical",
                "domain": [-0.05, 0.05]
            },
            "stacked": ["sign", "fuel"],
            "axis": {
                "ticks": 7,
                "position": "left",
                "grid": true,
                "format": "+.0%"
            },
            "hover": {
                "format": "+.1%"
            }
        },
        "fuel": {
            "column": "fuel",
            "props": {
                "manual": {
                    "total":       { "name": "Gesamt (Erdgas, Mineralöl, Kohle)" },
                    "oil":         { "name": "Mineralöl" },
                    "gas":         { "name": "Erdgas" },
                    "coal":        { "name": "Kohle" },
                    "intaviation": { "name": "Internationaler Flugverkehr" }
                }
            }
        },
        "sign": {
            "column": "sign",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "rect",
                        "props": {
                            "x": 0, "y": 0, "width": 16, "height": 15,
                            "fill": "@color", "rx": 2
                        }
                    }]
                }
            },
            "props": {
                "common": {
                    "size": 2
                },
                "manual": {
                    "higher": { "color": "#cf8e02", "name": "Eigene Berechnung höher" },
                    "lower":  { "color": "#3b95d0", "name": "Eigene Berechnung niedriger" }
                }
            },
            "hover": {
            }
        }
    },
    "facets": {
        "dim": ["fuel"],
        "scales": ["x", "y"],
        "cols": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [
                {"cut":   0, "value": 1},
                {"cut": 550, "value": 2}
            ]
        }
    },
    "plot": [
        {
            "type": "stackedBar",
            "categories": ["sign"],
            "props": {
                "fill": "@color",
                "opacity": 0.9,
                "x": "@x",
                "y": "@y",
                "width": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.035
                }
            }
        }
    ]
}
