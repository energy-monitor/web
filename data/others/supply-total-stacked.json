{
    "data": "supply-total-monthly.csv",
    "options": {
        "height": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [
                {"cut":   0, "value": 220},
                {"cut": 550, "value": 260},
                {"cut": 600, "value": 300}
            ]
        },
        "margins": {"top": 15, "right": 30, "bottom": 45, "left": 50},
        "title": "Absatz von fossilen Energieträgern",
        "subtitle": "monatlich, nach Energiegehalt in TWh bzw. Emissionen in Mt CO₂, oder Anteile",
        "footer": "Source: eurostat, eigene Berechnungen"
    },
    "globals": {
        "unit": "twh",
        "share": ""
    },
    "formElements": [{
        "id": "unitSupplyStacked",
        "name": "Einheit",
        "ref": "unit",
        "type": "switch",
        "values": [
            { "id": "unitSupplyStackedTwh", "value": "twh", "name": "TWh" },
            { "id": "unitSupplyStackedCo2", "value": "mt.co2", "name": "Mt CO₂" }
        ]
    }, {
        "id": "valuesSupplyStacked",
        "name": "Werte",
        "ref": "share",
        "type": "switch",
        "values": [
            { "id": "valuesSupplyStackedAbs", "value": "", "name": "Absolut" },
            {
                "id": "valuesSupplyStackedShare", "value": ".share", "name": "Anteil",
                "mapping": {
                    "y": {
                        "scale": { "domain": [0, 1], "domainRel": [0, 0] },
                        "axis": { "format": ".0%" },
                        "hover": { "format": ".1%" }
                    }
                }
            }
        ]
    }],
    "mapping": {
        "x": {
            "column": "date",
            "type": "date",
            "scale": {
                "type": "time",
                "orientation": "horizontal",
                "domainAbs": [-2000000000, 2000000000]
            },
            "axis": {
                "ticks": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.017
                },
                "position": "bottom",
                "rotate": 35,
                "format": "%b %y"
            },
            "hover": {
                "format": "%b %y"
            }
        },
        "y": {
            "column": "{unit}{share}",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "orientation": "vertical",
                "domain": [0, null],
                "domainRel": [0, 0.1]
            },
            "stacked": true,
            "axis": {
                "ticks": 6,
                "position": "left",
                "grid": true,
                "format": ",.0f"
            },
            "hover": {
                "format": ",.2f"
            }
        },
        "type": {
            "column": "product",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "rect",
                        "props": {
                            "x": 0, "y": 0, "width": 16, "height": 15,
                            "fill": "@color", "rx": 2
                        }
                    }]
                }
            },
            "props": {
                "manual": {
                    "oil":  { "color": "#6F625A", "name": "Mineralöl" },
                    "coal": { "color": "#F2A03D", "name": "Kohle" },
                    "gas":  { "color": "#86CAE7", "name": "Erdgas" }
                }
            },
            "hover": {
            }
        }
    },
    "plot": [
        {
            "type": "stackedBar",
            "categories": ["type"],
            "props": {
                "fill": "@color",
                "opacity": 0.9,
                "x": "@x",
                "y": "@y",
                "width": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.008
                }
            }
        }
    ]
}
