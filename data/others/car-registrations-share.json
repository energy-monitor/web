{
    "data": "car-registrations.csv",
    "options": {
        "height": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [
                {"cut":   0, "value": 220},
                {"cut": 550, "value": 260},
                {"cut": 600, "value": 300}
            ]
        },
        "margins": {"top": 5, "right": 30, "bottom": 45, "left": 50},
        "title": "Anteile an den Pkw-Neuzulassungen",
        "subtitle": "nach Kraftstoffart bzw. Energiequelle, monatlich, in %, AT",
        "footer": "Source: Statistik Austria - Kfz-Neuzulassungen"
    },
    "mapping": {
        "x": {
            "column": "date",
            "type": "date",
            "scale": {
                "type": "time",
                "orientation": "horizontal",
                "domainAbs": [-2000000000, 2000000000]
            },
            "axis": {
                "ticks": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.017
                },
                "position": "bottom",
                "rotate": 35,
                "format": "%b %y"
            },
            "hover": {
                "format": "%b %y"
            }
        },
        "y": {
            "column": "share",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "orientation": "vertical",
                "domain": [0, 1]
            },
            "stacked": true,
            "axis": {
                "ticks": 5,
                "position": "left",
                "grid": true,
                "format": ".0%"
            },
            "hover": {
                "format": ".1%"
            }
        },
        "type": {
            "column": "type",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "rect",
                        "props": {
                            "x": 0, "y": 0, "width": 16, "height": 15,
                            "fill": "@color", "rx": 2
                        }
                    }]
                }
            },
            "props": {
                "manual": {
                    "bev":    { "color": "#2e8b57", "name": "Elektro" },
                    "diesel": { "color": "#8B4513", "name": "Diesel" },
                    "hybrid": { "color": "#3b95d0", "name": "Hybrid (ohne Plug-in)" },
                    "other":  { "color": "#6b4c9a", "name": "Sonstige" },
                    "petrol": { "color": "#c47a00", "name": "Benzin" },
                    "phev":   { "color": "#2a9d8f", "name": "Plug-in-Hybrid" }
                }
            },
            "hover": {
            }
        }
    },
    "plot": [
        {
            "type": "stackedBar",
            "categories": ["type"],
            "props": {
                "fill": "@color",
                "opacity": 0.9,
                "x": "@x",
                "y": "@y",
                "width": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.008
                }
            }
        }
    ]
}
