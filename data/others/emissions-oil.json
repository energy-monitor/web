{
    "data": "emissions-oil.csv",
    "options": {
        "height": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [
                {"cut":   0, "value": 220},
                {"cut": 550, "value": 260},
                {"cut": 600, "value": 300}
            ]
        },
        "margins": {"top": 5, "right": 30, "bottom": 45, "left": 50},
        "title": "CO₂-Emissionen aus Mineralölprodukten",
        "subtitle": "nach Produkt, gleitender 12-Monats-Durchschnitt, in Kilotonnen CO₂ pro Monat",
        "footer": "Source: eurostat - nrg_cb_oilm; Umweltbundesamt - NID 2026; eigene Berechnungen"
    },
    "mapping": {
        "x": {
            "column": "date",
            "type": "date",
            "scale": {
                "type": "time",
                "orientation": "horizontal",
                "domainAbs": [-2000000000, 2000000000]
            },
            "axis": {
                "ticks": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.017
                },
                "label": "Year",
                "position": "bottom",
                "rotate": 35,
                "format": "%b %y"
            },
            "hover": {
                "format": "%b %y"
            }
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "orientation": "vertical",
                "domain": [0, null],
                "domainRel": [0, 0.13]
            },
            "stacked": ["product"],
            "axis": {
                "ticks": 7,
                "position": "left",
                "grid": true,
                "format": ",.0f"
            },
            "hover": {
                "format": ",.0f"
            }
        },
        "product": {
            "column": "product",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "rect",
                        "props": {
                            "x": 0, "y": 0, "width": 16, "height": 15,
                            "fill": "@color", "rx": 2
                        }
                    }]
                }
            },
            "props": {
                "common": {
                    "size": 2
                },
                "manual": {
                    "gasoil":      { "color": "#4D4D4D", "name": "Gasöl und Diesel" },
                    "gasoline":    { "color": "#cf8e02", "name": "Benzin" },
                    "others":      { "color": "#86cae7", "name": "Sonstige (Heizöl, Flüssiggas, Kerosin Inland)" },
                    "correction":  { "color": "#CCCCCC", "name": "Nicht zugeordnet (Kalibrierung an NID)" }
                }
            },
            "hover": {
            }
        }
    },
    "plot": [
        {
            "type": "stackedBar",
            "categories": ["product"],
            "props": {
                "fill": "@color",
                "opacity": 0.9,
                "x": "@x",
                "y": "@y",
                "width": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.008
                }
            }
        }
    ]
}
