{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "marks": [
        {
            "type": "area",
            "id": "bands",
            "by": "type",
            "stack": true,
            "layer": "below",
            "filter": "@values == 'share'",
            "fill": "none",
            "stroke": "none",
            "pointer-events": "none"
        },
        {
            "type": "text",
            "id": "names",
            "by": "type",
            "place": {"in": "bands"},
            "layer": "above",
            "filter": "@values == 'share'",
            "halo": true,
            "text": "@name",
            "fill": "#222",
            "font-size": 11,
            "font-weight": "bold",
            "pointer-events": "none",
            "highlight": {"opacity": 1},
            "others": {"opacity": 0.3}
        }
    ]
}
