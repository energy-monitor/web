{
    "parent": "../_years.json",
    "data": "precipitation.parquet",
    "title": "Niederschlag Österreich",
    "subtitle": "Summe der letzten 90 Tage, Flächenmittel, in mm",
    "source": "Quelle: GeoSphere Austria (SPARTACUS)",
    "dims": {
        "y": {"column": "value", "scale": {"pad": [0, 0.1]}, "zero": true},
        "year": {
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 16,
                                "y1": 8,
                                "y2": 8,
                                "stroke": "@color",
                                "stroke-width": "@stroke-width",
                                "stroke-dasharray": "@stroke-dasharray",
                                "opacity": "@opacity"
                            }
                        }
                    ]
                }
            },
            "categories": {
                "avg60-90": {
                    "color": "#888",
                    "opacity": 0.9,
                    "stroke-dasharray": "4, 3",
                    "name": "Ø 1961 - 1990"
                },
                "avg90-20": {
                    "color": "#444",
                    "opacity": 0.9,
                    "stroke-dasharray": "8, 3",
                    "name": "Ø 1991 - 2020"
                }
            }
        }
    },
    "marks": {"stroke-dasharray": "@stroke-dasharray"}
}
