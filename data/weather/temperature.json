{
    "parent": "../_years.json",
    "data": "temperature.parquet",
    "title": "Temperatur Österreich",
    "subtitle": "gewichtet nach Bevölkerung, täglich (rollierender 4-Wochen Durchschnitt), in °C",
    "source": "Quelle: ERA5",
    "dims": {
        "y": {"column": "value", "zero": false, "pad": 0.1},
        "year": {
            "categories": {
                "avg40-60": {
                    "color": "#BBB",
                    "opacity": 0.9,
                    "stroke-dasharray": "1, 3",
                    "name": "Ø 1940 - 1960"
                },
                "avg60-90": {
                    "color": "#888",
                    "opacity": 0.9,
                    "stroke-dasharray": "4, 3",
                    "name": "Ø 1961 - 1990"
                },
                "avg90-20": {
                    "color": "#444",
                    "opacity": 0.9,
                    "stroke-dasharray": "8, 3",
                    "name": "Ø 1991 - 2020"
                }
            }
        }
    },
    "marks": {"stroke-dasharray": "@stroke-dasharray"}
}
