{
    "parent": "_timeline.json",
    "height": "=steps(@totalWidth, {0: 220, 550: 260, 600: 300})",
    "margins": {"top": 15, "bottom": 45},
    "dims": {"type": {"legend": {"symbol": "rect"}}},
    "marks": [
        {
            "type": "bar",
            "id": "bars",
            "by": "type",
            "stack": true,
            "opacity": 0.9,
            "width": "@innerWidth * 0.008",
            "highlight": {"mode": "row", "opacity": 1}
        }
    ]
}
